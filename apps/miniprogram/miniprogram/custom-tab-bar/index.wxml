<view class="tab-bar">
  <view class="tabs" role="tablist" aria-label="主导航">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      hover-class="tab-pressed"
      role="tab"
      aria-selected="{{selected === index}}"
    >
      <view class="icon-wrap"><image class="icon" src="{{item.iconPath}}" mode="aspectFit"></image></view>
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
