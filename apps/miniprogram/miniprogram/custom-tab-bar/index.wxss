:host { display: block; width: 100%; height: 0; box-sizing: border-box; }
.tab-bar { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; box-sizing: border-box; overflow: hidden; height: calc(72px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: rgba(251, 249, 248, .98); box-shadow: 0 -8px 24px rgba(21, 59, 46, .03); }
.tabs { display: grid; width: 100%; min-width: 0; height: 72px; box-sizing: border-box; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; padding: 6px 14px; border-top: 1rpx solid #e4e6e1; }
.tab { display: flex; width: 100%; max-width: 100%; min-width: 0; min-height: 60px; box-sizing: border-box; margin: 0; padding: 2px 4px; flex-direction: column; align-items: center; justify-content: center; gap: 2px; border-radius: 14px; background: transparent; color: #717974; font-size: 15px; font-weight: 500; line-height: 20px; }
.tab-pressed { background: #f2f3ef; }
.tab.active { color: #153b2e; font-weight: 600; }
.icon-wrap { display: grid; width: 38px; height: 28px; place-items: center; border-radius: 14px; }
.tab.active .icon-wrap { background: #e8eee9; }
.icon { width: 21px; height: 21px; opacity: .58; }
.tab.active .icon { opacity: 1; }
