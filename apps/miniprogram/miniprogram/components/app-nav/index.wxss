:host { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: block; height: calc(238rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.nav-shell { position: relative; display: flex; box-sizing: border-box; width: 100%; height: 100%; padding-bottom: env(safe-area-inset-bottom); flex-direction: column; background: rgba(251, 249, 248, .98); box-shadow: 0 -10rpx 32rpx rgba(21, 59, 46, .05); }
.create-row { display: flex; box-sizing: border-box; width: 100%; padding: 12rpx 32rpx 10rpx; }
.create { display: flex; box-sizing: border-box; width: 100%; min-height: 96rpx; flex: 1; margin: 0; align-items: center; justify-content: center; gap: 14rpx; border-radius: 48rpx; background: #153b2e; color: #fff; font-size: 30rpx; font-weight: 500; line-height: 64rpx; }
.create-pressed { background: #214d3d; }
.create-icon { position: relative; width: 34rpx; height: 34rpx; border: 2rpx solid currentColor; border-radius: 7rpx; }
.pen-line { position: absolute; width: 26rpx; height: 4rpx; top: 13rpx; left: 10rpx; background: currentColor; transform: rotate(-45deg); transform-origin: center; }
.tabs { display: grid; box-sizing: border-box; width: 100%; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 6rpx 24rpx 8rpx; border-top: 1rpx solid #e4e6e1; }
.tab { display: flex; box-sizing: border-box; width: 100%; min-width: 0; min-height: 104rpx; margin: 0; padding: 8rpx; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; border-radius: 24rpx; background: transparent; color: #717974; font-size: 25rpx; line-height: 36rpx; }
.tab.active { background: #e8eee9; color: #153b2e; font-weight: 600; }
.tab-pressed { background: #eef1ed; }
.icon { position: relative; width: 36rpx; height: 36rpx; }
.flame { border: 3rpx solid currentColor; border-radius: 60% 40% 58% 42%; transform: rotate(45deg) scale(.64); }
.paper { border: 3rpx solid currentColor; border-radius: 5rpx; }
.paper::after { content: ""; position: absolute; right: 6rpx; bottom: 8rpx; left: 6rpx; height: 3rpx; background: currentColor; box-shadow: 0 -10rpx 0 currentColor; }
.person::before, .person::after { content: ""; position: absolute; left: 50%; border: 3rpx solid currentColor; transform: translateX(-50%); }
.person::before { width: 15rpx; height: 15rpx; border-radius: 50%; top: 2rpx; }
.person::after { width: 30rpx; height: 17rpx; border-radius: 20rpx 20rpx 4rpx 4rpx; bottom: 2rpx; }
