<view class="author-library">
  <view class="works-heading">
    <view class="library-heading"><text wx:if="{{!recycle}}" class="library-title">我的文章</text><text class="works-count">{{recycle ? '误删的文章可以在这里恢复' : total + ' 篇'}}</text></view>
    <button wx:if="{{!recycle && total}}" class="manage-entry text-action" bindtap="toggleManage">{{manage ? '完成' : '管理'}}</button>
  </view>
  <view wx:if="{{!recycle}}" class="work-filters" role="tablist">
    <button class="filter-button {{filter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'all'}}">全部</button>
    <button class="filter-button {{filter === 'draft' ? 'selected' : ''}}" data-filter="draft" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'draft'}}">草稿</button>
    <button class="filter-button {{filter === 'pending' ? 'selected' : ''}}" data-filter="pending" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'pending'}}">审核中</button>
    <button class="filter-button {{filter === 'published' ? 'selected' : ''}}" data-filter="published" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'published'}}">已发表</button>
  </view>
  <view wx:if="{{issue}}" class="error-panel" role="alert">{{issue}}</view>
  <view wx:if="{{loading}}" class="empty-state">正在读取文章…</view>
  <view wx:elif="{{empty && statusUnavailable && !recycle && total && filter !== 'all'}}" class="empty-state">
    <view class="empty-title">发表状态暂未更新</view>
    <view>可以切换到“全部”继续编辑，或联网后重试。</view>
    <button class="text-action" bindtap="refresh">重新读取</button>
  </view>
  <view wx:elif="{{empty}}" class="empty-state">
    <image class="empty-icon" src="/assets/book.svg" mode="aspectFit" />
    <view class="empty-title">{{recycle ? '回收站是空的' : filter === 'all' ? '还没有写下文章' : filter === 'pending' ? '没有审核中的文章' : filter === 'published' ? '还没有发表的文章' : '还没有草稿'}}</view>
    <view>{{recycle ? '恢复后的文章会保留为私有草稿。' : filter === 'all' ? '从想说的一句话开始。' : '切换到“全部”，可以查看其他文章。'}}</view>
  </view>
  <view class="work-list" wx:else>
    <view class="work-card" wx:for="{{visible}}" wx:key="id">
      <view class="work-copy" data-id="{{item.id}}" bindtap="openArticle" role="button" aria-label="{{item.action + '：' + item.title}}">
        <view class="work-title">{{item.title || '未命名文章'}}</view>
        <view class="work-meta">{{item.meta}}</view>
      </view>
      <view class="work-bottom">
        <text class="publication-label state-{{item.category}}">{{item.recovery ? '本机恢复稿' : recycle ? '已移入回收站' : item.publication}}</text>
        <view class="work-actions" wx:if="{{recycle}}">
          <button class="text-action" data-id="{{item.id}}" data-revision="{{item.revision}}" catchtap="restore">恢复</button>
          <button class="text-action danger" data-id="{{item.id}}" data-revision="{{item.revision}}" catchtap="permanentlyDelete">永久删除</button>
        </view>
        <view wx:elif="{{item.recovery}}" class="work-actions recovery-actions"><button class="text-action" data-id="{{item.id}}" catchtap="viewRecovery">查看</button><button class="text-action" data-id="{{item.id}}" catchtap="promoteRecovery">另存新篇</button><button class="text-action" data-id="{{item.id}}" catchtap="exportRecovery">导出</button></view>
        <button wx:elif="{{manage}}" class="remove text-action" data-id="{{item.id}}" data-revision="{{item.revision}}" disabled="{{deleting}}" catchtap="moveToRecycle">删除</button>
        <view wx:else class="work-actions"><button class="article-entry text-action" data-id="{{item.id}}" catchtap="openArticle">{{item.action}} <text aria-hidden="true">›</text></button></view>
      </view>
    </view>
  </view>
  <button wx:if="{{hasMore}}" class="library-more text-action" bindtap="more">查看更多文章</button>
</view>
