<view class="author-library {{embedded ? 'author-overview' : ''}}">
  <block wx:if="{{embedded}}">
    <button wx:if="{{!loading && total}}" class="overview-write primary-action" bindtap="startWriting">写文章</button>
    <view wx:if="{{issue && !suppressIssue}}" class="library-issue" role="alert"><text>{{issue}}</text><button class="text-action" bindtap="retry">重试</button></view>
    <view wx:if="{{loading}}" class="empty-state">正在读取文章…</view>
    <block wx:elif="{{total}}">
      <block wx:if="{{recentDraft}}">
        <view class="overview-heading"><text class="overview-title">最近在写</text><text class="overview-date">{{recentDraft.date}}</text></view>
        <button class="recent-draft" data-id="{{recentDraft.id}}" bindtap="openArticle" aria-label="编辑：{{recentDraft.title}}">
          <view class="recent-draft-title">{{recentDraft.title}}</view><view class="recent-draft-excerpt">{{recentDraft.excerpt || '从想说的一句话开始……'}}</view>
          <view class="recent-draft-bottom"><text>{{recentDraft.words}} 字</text><view class="draft-arrow"><view /></view></view>
        </button>
      </block>
      <view class="overview-heading all-heading"><text class="overview-title">我的文章</text><button class="text-action all-entry" bindtap="openAll">全部 {{total}} 篇<view class="row-chevron" /></button></view>
      <view class="recent-list">
        <button class="recent-row" wx:for="{{recentCards}}" wx:key="id" data-id="{{item.id}}" bindtap="openArticle" aria-label="{{item.action + '：' + item.title}}">
          <view class="recent-copy"><view class="recent-title">{{item.title}}</view><view class="recent-meta"><text class="state-{{item.category}}">{{item.recovery ? '本机恢复稿' : item.publication}}</text><text>·</text><text>{{item.date}}</text></view></view><view class="row-chevron" />
        </button>
      </view>
    </block>
    <view wx:elif="{{!issue}}" class="new-author"><image src="/assets/letter.svg" mode="aspectFit" /><view class="empty-title">从一篇自己的文章开始</view><view>记一件小事，写一首诗，<view>也可以聊聊今天的想法。</view></view><button class="primary-action" bindtap="startWriting">写第一篇文章</button></view>
    <button wx:else class="text-action all-entry error-all" bindtap="openAll">查看我的全部文章<view class="row-chevron" /></button>
  </block>
  <block wx:else>
    <view wx:if="{{!recycle}}" class="search-box"><view class="search-icon" /><input value="{{query}}" bindinput="searchArticles" placeholder="搜索文章标题" confirm-type="search" aria-label="搜索文章标题" /></view>
    <view wx:if="{{!recycle}}" class="work-filters" role="tablist" aria-label="文章状态">
      <button class="filter-button {{filter === 'all' ? 'selected' : ''}}" data-filter="all" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'all'}}">全部</button>
      <button class="filter-button {{filter === 'draft' ? 'selected' : ''}}" data-filter="draft" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'draft'}}">草稿</button>
      <button class="filter-button {{filter === 'pending' ? 'selected' : ''}}" data-filter="pending" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'pending'}}">审核中</button>
      <button class="filter-button {{filter === 'published' ? 'selected' : ''}}" data-filter="published" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'published'}}">已发表</button>
    </view>
    <view wx:if="{{recycle && total}}" class="recycle-intro">误删的文章可以在这里恢复，恢复后保留为私有草稿。</view>
    <view wx:if="{{issue}}" class="library-issue" role="alert"><text>{{issue}}</text><button class="text-action" bindtap="retry">重试</button></view>
    <view wx:if="{{loading}}" class="empty-state">正在读取文章…</view>
    <view wx:elif="{{empty && statusUnavailable && !recycle && total && filter !== 'all'}}" class="empty-state"><view class="empty-title">发表状态暂未更新</view><view>可以切换到“全部”继续编辑，或联网后重试。</view><button class="text-action" bindtap="retry">重新读取</button></view>
    <view wx:elif="{{empty}}" class="empty-state">
      <image class="empty-icon" src="{{recycle ? '/assets/recycle.svg' : '/assets/letter.svg'}}" mode="aspectFit" />
      <view class="empty-title">{{query ? '没有找到这篇文章' : recycle ? '回收站是空的' : filter === 'all' ? '还没有写下文章' : filter === 'pending' ? '没有审核中的文章' : filter === 'published' ? '还没有发表的文章' : '还没有草稿'}}</view>
      <view>{{query ? '试试换一个标题关键词。' : recycle ? '误删的文章可以在这里找回。' : filter === 'all' ? '从想说的一句话开始。' : '切换到“全部”，可以查看其他文章。'}}</view>
      <button wx:if="{{!query && !recycle && !total}}" class="text-action" bindtap="startWriting">写第一篇文章</button>
    </view>
    <view wx:else class="work-list">
      <view class="work-card" wx:for="{{visible}}" wx:key="id">
        <view wx:if="{{recycle}}" class="work-title">{{item.title}}</view>
        <button wx:else class="work-copy" data-id="{{item.id}}" bindtap="openArticle" aria-label="{{item.action + '：' + item.title}}"><view class="work-title">{{item.title}}</view><view class="work-excerpt">{{item.excerpt || '还没有写下正文'}}</view></button>
        <view class="work-bottom"><view class="work-meta"><text class="publication-label state-{{item.category}}">{{item.recovery ? '本机恢复稿' : recycle ? '已移入回收站' : item.publication}}</text><text>·</text><text>{{item.date}}</text><text>·</text><text>{{item.words}} 字</text></view>
          <view class="work-actions"><button wx:if="{{recycle}}" class="text-action" data-id="{{item.id}}" data-revision="{{item.revision}}" disabled="{{deleting}}" catchtap="restore">恢复</button><button class="work-more" data-id="{{item.id}}" bindtap="openMenu" disabled="{{deleting}}" aria-label="{{item.title + '的更多操作'}}"><view /><view /><view /></button></view>
        </view>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="library-more text-action" bindtap="more">查看更多文章</button>
  </block>
</view>
