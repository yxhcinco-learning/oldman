:host { display: block; position: sticky; top: 0; z-index: 30; }
.page-header { position: relative; background: #fbf9f8; }
.header-row { position: absolute; left: 0; right: 0; display: flex; align-items: center; height: 48px; padding-left: 8px; box-sizing: border-box; }
.header-row .header-back { display: flex; width: 48px; min-width: 48px; max-width: 48px; height: 48px; flex: 0 0 48px; padding: 0; margin: 0; align-items: center; justify-content: center; border: 0; border-radius: 24px; background: transparent; color: #153b2e; }
.header-row .header-back::after { border: 0; }
.back-chevron { width: 10px; height: 10px; border-bottom: 2px solid currentColor; border-left: 2px solid currentColor; transform: rotate(45deg); }
.header-title { flex: 1; min-width: 0; margin-left: 4px; overflow: hidden; color: #153b2e; font: 600 20px/28px "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
.header-row .header-action { display: flex; flex: 0 0 auto; width: auto; min-width: 48px; min-height: 48px; margin: 0; padding: 8px; align-items: center; justify-content: center; border: 0; border-radius: 0; background: transparent; color: #416657; font: 400 16px/24px "Manrope", "PingFang SC", "Microsoft YaHei", sans-serif; }
.header-action::after { border: 0; }
.header-row .header-action.is-disabled { color: #717974; }

.page-header.dark { background: #17211c; }
.dark .header-title, .dark .header-back { color: #fff; }
