<view class="page-header {{dark ? 'dark' : ''}}" style="height: {{navigationHeight}}px">
  <view class="header-row" style="top: {{navigationRowTop}}px; padding-right: {{menuReserve}}px">
    <button class="header-back" bindtap="back" aria-label="返回"><view class="back-chevron" /></button>
    <view class="header-title">{{title}}</view>
    <button wx:if="{{actionText}}" class="header-action {{actionDisabled ? 'is-disabled' : ''}}" disabled="{{actionDisabled}}" bindtap="action">{{actionText}}</button>
  </view>
</view>
