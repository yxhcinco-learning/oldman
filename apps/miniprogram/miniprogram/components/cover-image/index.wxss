:host { display: block; flex: none; width: 100%; height: 100%; }
.cover-window { position: relative; overflow: hidden; border-radius: inherit; background: #e8eee9; }
.cover-picture { position: absolute; }
.cover-feedback, .cover-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #496451; font: 14px/22px -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; text-align: center; }
.cover-feedback { background: #e8eee9; }
.cover-retry { display: flex; align-items: center; justify-content: center; min-width: 48px; min-height: 48px; font-weight: 500; }
.cover-detail { margin-top: 4px; font-size: 12px; }
.cover-loading { pointer-events: none; }
