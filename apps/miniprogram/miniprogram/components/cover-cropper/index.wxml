<view class="crop-window" style="width: {{frameWidth}}px; height: {{frameHeight}}px" catchtouchstart="begin" catchtouchmove="move" catchtouchend="end" catchtouchcancel="end" aria-label="拖动图片调整封面">
  <image class="crop-image" src="{{src}}" style="width: {{drawWidth}}px; height: {{drawHeight}}px; left: {{left}}px; top: {{top}}px" mode="scaleToFill" binderror="imageFailed" bindload="imageLoaded" />
  <view class="crop-grid"><view class="crop-line" /><view class="crop-line second" /></view>
  <view wx:if="{{failed}}" class="crop-failed">图片暂未显示，请返回重试</view>
</view>
<view class="crop-adjust-caption {{dark ? 'dark' : ''}}"><text>拖动或双指缩放</text><button class="crop-reset" bindtap="reset" disabled="{{disabled}}"><text aria-hidden="true">↶</text>还原</button></view>
<view class="crop-controls {{dark ? 'dark' : ''}}"><button class="crop-control {{zoom <= 1 ? 'disabled' : ''}}" bindtap="shrink" aria-label="缩小封面" disabled="{{disabled || zoom <= 1}}">−</button><slider class="crop-slider" min="{{1}}" max="{{4}}" step="{{0.01}}" value="{{zoom}}" disabled="{{disabled}}" bindchanging="zoomChanging" bindchange="zoomChanged" activeColor="#c5d9cb" backgroundColor="#516958" block-color="#e2eee5" block-size="{{20}}" aria-label="调整封面缩放" /><button class="crop-control {{zoom >= 4 ? 'disabled' : ''}}" bindtap="enlarge" aria-label="放大封面" disabled="{{disabled || zoom >= 4}}">＋</button></view>
