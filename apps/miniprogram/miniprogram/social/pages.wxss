.public-author-identity { display: flex; align-items: center; gap: 14px; padding: 20px 0 24px; }
.public-author-identity > image { flex: 0 0 64px; width: 64px; height: 64px; padding: 16px; background: var(--tint); border-radius: 50%; }
.public-author-identity .social-heading { flex: 1; min-width: 0; font-size: 26px; line-height: 36px; }
.author-stats { display: flex; gap: 12px; padding: 10px 0 28px; border-bottom: 1px solid var(--line); }
.author-stats > view { flex: 1; text-align: center; font-size: 14px; color: var(--muted); }
.author-stats text { display: block; color: var(--forest); font-size: 23px; line-height: 34px; }
.social-section-title { margin-top: 28px; color: var(--forest); font: 600 22px/34px var(--font-article); }
.unavailable-collection { display: flex; align-items: center; gap: 14px; min-height: 68px; color: var(--muted); font-size: 18px; line-height: 30px; }
.unavailable-collection image { width: 32px; height: 32px; opacity: .5; }
.relationship-tabs { display: flex; margin-bottom: 12px; border-bottom: 1px solid var(--line); }
.relationship-tabs button { width: auto; margin: 0; flex: 1; border-radius: 0; padding: 10px; color: var(--muted); }
.relationship-tabs button.active { color: var(--forest); box-shadow: inset 0 -2px var(--forest); }
.relationship-row { display: flex; align-items: center; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--line); }
.relationship-person { width: 0; margin: 0; justify-content: flex-start; display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; padding: 0; text-align: left; }
.relationship-person > image { flex: 0 0 48px; width: 48px; height: 48px; padding: 12px; border-radius: 50%; background: var(--tint); }
.relationship-person > view { flex: 1; min-width: 0; }
.relationship-person text { display: block; overflow-wrap: anywhere; }
.wallet-balance { padding: 28px 0 20px; text-align: center; }
.wallet-balance > image { display: block; width: 82px; height: 94px; margin: 0 auto 20px; }
.wallet-number { color: var(--forest); font-size: 48px; line-height: 62px; }
.wallet-number text { display: block; font-size: 18px; line-height: 30px; }
.wallet-rules { padding: 20px; border-radius: 18px; background: var(--tint); font-size: 15px; line-height: 28px; color: var(--forest-soft); }
.flower-history { display: flex; align-items: center; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 16px; line-height: 27px; color: var(--forest); }
.flower-history > image { flex: 0 0 26px; width: 26px; height: 26px; }.flower-history > view { flex: 1; }.flower-history > view text { display: block; color: var(--muted); font-size: 14px; }
@media (max-width: 370px) { .public-author-identity { gap: 10px; }.public-author-identity .social-heading { font-size: 23px; line-height: 34px; }.public-author-identity > image { width: 56px; height: 56px; flex-basis: 56px; }.public-author-identity .follow-button { min-width: 82px; padding-left: 10px; padding-right: 10px; }.relationship-row { gap: 8px; }.relationship-person { gap: 8px; } }

.social-page .relationship-row > button.relationship-person { width: 0; margin: 0; padding: 0; justify-content: flex-start; }
.social-page .relationship-tabs > button { width: auto; margin: 0; }
