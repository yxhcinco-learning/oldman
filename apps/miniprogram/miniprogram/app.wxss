page {
  --paper: #fbf9f8;
  --white: #ffffff;
  --surface: #f5f3f3;
  --surface-mid: #efeded;
  --forest: #153b2e;
  --forest-soft: #416657;
  --tint: #e8eee9;
  --sienna: #944924;
  --ink: #1b1c1c;
  --muted: #717974;
  --line: #e4e6e1;
  --page-gutter: 24px;
  --font-ui: Manrope, "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-article: "Noto Serif SC", "Songti SC", SimSun, serif;
  box-sizing: border-box;
  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: Manrope, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, input, textarea, scroll-view, navigator, image { box-sizing: border-box; }
button, input, textarea { font: inherit; }
button { width: auto; max-width: 100%; min-width: 0; min-height: 48px; margin: 0; padding: 8px 16px; border: 0; border-radius: 24px; background: transparent; color: var(--forest-soft); font-size: 16px; line-height: 26px; }
button::after { border: 0; }
button[disabled] { color: var(--muted); }
.page-shell { min-height: 100vh; padding: 0 24px calc(80px + env(safe-area-inset-bottom)); }
.page-shell.without-nav { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.eyebrow { margin: 0 0 12px; color: var(--sienna); font-size: 14px; line-height: 20px; }
.page-title { color: var(--forest); font-family: "Noto Serif SC", "Songti SC", SimSun, serif; font-size: 26px; font-weight: 700; letter-spacing: .06em; line-height: 36px; }
.page-title .period { color: var(--sienna); }
.lead { margin-top: 8px; color: var(--muted); font-size: 16px; line-height: 26px; }
button.primary-action, button.secondary-action { display: flex; width: 100%; max-width: 100%; min-width: 0; min-height: 56px; margin: 0; padding: 12px 16px; align-items: center; justify-content: center; border-radius: 28px; font-size: 18px; line-height: 28px; }
button.primary-action { background: var(--forest); color: var(--white); }
button.secondary-action { background: var(--tint); color: var(--forest); }
button.primary-action[disabled], button.secondary-action[disabled] { background: var(--surface-mid); color: var(--muted); }
button.text-action { display: inline-flex; width: auto; flex: 0 0 auto; min-height: 48px; margin: 0; padding: 8px 12px; align-items: center; justify-content: center; background: transparent; color: var(--forest-soft); }
.action-row { display: flex; flex-wrap: wrap; gap: 12px; min-width: 0; }
.action-row > button { flex: 1; min-width: 0; }
.page-actions { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 12px var(--page-gutter) calc(16px + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1px solid var(--line); }
.notice, .error-panel { margin-top: 12px; padding: 11px 13px; border-radius: 12px; font-size: 14px; line-height: 22px; }
.notice { background: var(--tint); color: var(--forest-soft); }
.error-panel { background: #f5e8df; color: #6f351c; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

@media (max-width: 370px) {
  page { --page-gutter: 20px; }
  .page-shell { padding-left: 20px; padding-right: 20px; }
  .page-title { font-size: 25px; }
}
.ai-mode-bar { display: flex; flex: 0 0 auto; align-items: center; justify-content: flex-end; color: #416657; padding: 4px 24px; }
.ai-mode-bar button { display: flex; width: auto; flex: 0 0 auto; min-height: 48px; align-items: center; justify-content: center; line-height: 24px; font-size: 16px; color: #416657; background: transparent; border-radius: 0; padding: 8px 0; margin: 0; }
.reply-pending { display: flex; align-items: center; gap: 16px; color: #717974; }
.reply-pending button { min-height: 48px; padding: 8px 0; background: transparent; color: #416657; font-size: 14px; }
.thinking-dots { letter-spacing: 4px; animation: reply-breathe 1.4s ease-in-out infinite; }
@keyframes reply-breathe { 50% { opacity: .35; } }
@media (prefers-reduced-motion: reduce) { .thinking-dots { animation: none; } }
.xiaowen-topic { flex: 0 0 auto; padding: 0 24px 8px; color: #944924; font-size: 14px; line-height: 22px; overflow-wrap: anywhere; }
.conversation-topic { flex: 0 0 auto; min-width: 0; padding: 12px 24px 0; margin: 0; border-radius: 0; background: #e8eee9; }
.conversation-event { padding: 4px 0; color: #717974; font-size: 14px; line-height: 22px; background: transparent; }
.topic-heading { display: flex; align-items: center; gap: 12px; min-width: 0; }
.topic-heading image, .topic-heading > .icon { flex: 0 0 22px; width: 22px; height: 22px; color: #416657; }
.topic-window { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; font-size: 18px; line-height: 28px; color: #153b2e; }
.topic-text { display: inline-block; width: max-content; white-space: nowrap; }
.topic-moving { animation: topic-pan var(--topic-duration, 10s) ease-in-out infinite alternate; }
.topic-window:hover .topic-moving { animation-play-state: paused; }
@keyframes topic-pan { 0%,15% { transform: translateX(0); } 85%,100% { transform: translateX(var(--topic-distance, 0px)); } }
.conversation-topic .ai-mode-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 4px; padding: 0; }
.conversation-topic.topic-compact { display: flex; align-items: center; gap: 12px; padding-top: 4px; padding-bottom: 4px; }
.topic-compact .topic-heading { flex: 1; min-width: 0; }
.conversation-topic.topic-compact .ai-mode-bar { flex: 0 0 auto; margin-top: 0; margin-left: auto; }
.conversation-topic.topic-absent { display: block; padding-top: 0; padding-bottom: 0; background: transparent; }
.conversation-topic.topic-absent .ai-mode-bar { margin: 0; min-height: 48px; justify-content: flex-end; }
.topic-absent .topic-state { margin-right: auto; }
@media (max-width: 370px) { .conversation-topic { padding-right: 20px; padding-left: 20px; } }
.conversation-topic .ai-mode-bar button { flex-shrink: 0; min-height: 48px; padding: 10px 0 10px 12px; border: 0; border-radius: 0; background: transparent; color: #416657; font-size: 14px; line-height: 22px; white-space: nowrap; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
.topic-state { color: #416657; font-size: 14px; line-height: 22px; white-space: nowrap; }
.reply-pending { display: flex; flex-wrap: nowrap; align-items: center; gap: 5px; min-width: 25px; min-height: 26px; }
.reply-pending > i, .reply-pending > view { display: block; flex: 0 0 5px; width: 5px; height: 5px; border-radius: 50%; background: #718679; animation: reply-dot 1.3s ease-in-out infinite; }
.reply-pending .reply-dot-second { animation-delay: .15s; }
.reply-pending .reply-dot-third { animation-delay: .3s; }
@keyframes reply-dot { 0%,65%,100% { opacity: .4; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-2px); } }
.ai-stop { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px; width: 72px; padding: 8px; border-radius: 24px; background: #e8eee9; color: #153b2e; font-size: 16px; line-height: 24px; }
.ai-stop > span, .ai-stop > view { display: block; width: 9px; height: 9px; flex: 0 0 9px; border-radius: 2px; background: currentColor; }
.dictation-feedback { flex-shrink: 0; margin-top: 8px; margin-bottom: 8px; padding: 10px 12px; border-radius: 12px; background: #e8eee9; color: #416657; }
.dictation-caption { font-size: 14px; line-height: 22px; }
.dictation-transcript { max-height: 90px; margin-top: 4px; color: #1b1c1c; font-size: 18px; line-height: 30px; overflow-wrap: anywhere; }
.dictation-failed { background: #f5e8df; color: #6f351c; }
@media (prefers-reduced-motion: reduce) { .topic-moving, .reply-pending > i, .reply-pending > view { animation: none; } .topic-window { overflow-x: auto; } }
