page {
  --paper: #fbf9f8;
  --white: #ffffff;
  --surface: #f5f3f3;
  --surface-mid: #efeded;
  --forest: #153b2e;
  --forest-soft: #416657;
  --tint: #e8eee9;
  --sienna: #944924;
  --ink: #1b1c1c;
  --muted: #717974;
  --line: #e4e6e1;
  box-sizing: border-box;
  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: Manrope, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, input, textarea { box-sizing: border-box; }
button, input, textarea { font: inherit; }
button::after { border: 0; }
.page-shell { min-height: 100vh; padding: 36rpx 32rpx calc(260rpx + env(safe-area-inset-bottom)); }
.page-shell.without-nav { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.brand { color: var(--forest); font-family: "Noto Serif SC", "Songti SC", SimSun, serif; font-size: 29rpx; font-weight: 600; letter-spacing: 2rpx; }
.eyebrow { margin: 0 0 12rpx; color: var(--forest-soft); font-size: 24rpx; letter-spacing: 3rpx; }
.page-title { color: var(--forest); font-family: "Noto Serif SC", "Songti SC", SimSun, serif; font-size: 46rpx; font-weight: 600; line-height: 1.35; }
.lead { margin-top: 14rpx; color: var(--muted); font-size: 28rpx; line-height: 1.58; }
.primary-action, .secondary-action { min-height: 96rpx; padding: 16rpx 28rpx; border-radius: 48rpx; font-size: 30rpx; line-height: 64rpx; }
.primary-action { background: var(--forest); color: var(--white); }
.secondary-action { background: var(--tint); color: var(--forest); }
.notice, .error-panel { margin-top: 24rpx; padding: 22rpx 26rpx; border-radius: 24rpx; font-size: 26rpx; line-height: 1.6; }
.notice { background: var(--tint); color: var(--forest-soft); }
.error-panel { background: #f5e8df; color: #6f351c; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

@media (max-width: 370px) {
  .page-shell { padding-left: 28rpx; padding-right: 28rpx; }
  .page-title { font-size: 44rpx; }
}
