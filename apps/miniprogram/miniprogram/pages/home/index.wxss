.hero { margin: 28px 0 24px; }
.topic-state { padding: 18px 20px; border-radius: 16px; background: #f5f3f3; color: #717974; font-size: 15px; line-height: 24px; }
.topic-state.error-panel { margin-top: 0; background: #f5f3f3; color: #717974; }
.state-title { color: #717974; font-size: 15px; font-weight: 400; }
.state-help { margin: 4px 0 8px; color: #717974; font-size: 14px; line-height: 22px; }
.topic-state button { display: inline-flex; width: auto; min-height: 48px; margin: 8px 0 0; padding: 8px 14px; align-items: center; border-radius: 24px; background: #fff; color: #153b2e; font-size: 15px; line-height: 24px; }
.topic-list { display: grid; gap: 12px; }
.topic-card-row { display: flex; width: 100%; }
.topic-card { display: flex; width: 100%; max-width: none; min-height: 164px; flex: 1; margin: 0; padding: 20px; flex-direction: column; align-items: flex-start; border: 1px solid #e1e5dd; border-radius: 18px; background: #f3f3ed; color: #153b2e; text-align: left; }
.topic-card-row:nth-child(3n + 2) .topic-card { background: #f5eee8; }
.topic-card-row:nth-child(3n) .topic-card { background: #eaf0ea; }
.topic-meta { display: flex; flex-wrap: wrap; gap: 6px; }
.topic-meta text { min-height: 20px; padding: 3px 10px; border-radius: 20px; background: rgba(255,255,255,.72); color: #944924; font-size: 13px; line-height: 20px; }
.topic-title { margin-top: 10px; font-family: "Songti SC", serif; font-size: 19px; font-weight: 600; line-height: 28px; }
.topic-summary { display: -webkit-box; margin-top: 6px; overflow: hidden; color: #717974; font-size: 14px; line-height: 22px; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.topic-more { display: flex; margin-top: auto; padding-top: 12px; align-items: center; gap: 5px; color: #416657; font-size: 14px; line-height: 22px; }
.arrow { position: relative; width: 17px; height: 17px; }
.arrow::before { content: ""; position: absolute; top: 8px; left: 1px; width: 13px; height: 1px; background: currentColor; }
.arrow::after { content: ""; position: absolute; top: 5px; right: 2px; width: 5px; height: 5px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg); }
