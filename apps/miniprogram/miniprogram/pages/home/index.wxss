.home-page { padding-top: 28rpx; }
.hero { margin-top: 32rpx; }
.topic-state { margin-top: 30rpx; padding: 26rpx; border-radius: 24rpx; background: #f5f3f3; color: #717974; font-size: 27rpx; line-height: 1.6; }
.topic-state.error-panel { background: #f4f2ef; color: #5f6863; }
.state-title { color: #153b2e; font-size: 28rpx; font-weight: 600; }
.state-copy { margin-top: 8rpx; }
.topic-state button { display: inline-flex; width: auto; min-height: 96rpx; margin: 18rpx 0 0; padding: 12rpx 28rpx; align-items: center; border-radius: 48rpx; background: #fff; color: #153b2e; font-size: 27rpx; line-height: 48rpx; }
.topic-list { display: grid; gap: 20rpx; margin-top: 30rpx; }
.topic-card { display: flex; width: 100%; min-height: 312rpx; padding: 28rpx; flex-direction: column; align-items: flex-start; border: 1rpx solid #e1e5dd; border-radius: 28rpx; background: #f3f3ed; color: #153b2e; text-align: left; }
.topic-meta { display: flex; flex-wrap: wrap; gap: 12rpx; }
.topic-meta text { min-height: 48rpx; padding: 4rpx 18rpx; border-radius: 24rpx; background: #fff; color: #416657; font-size: 24rpx; line-height: 40rpx; }
.topic-title { margin-top: 18rpx; font-family: "Songti SC", serif; font-size: 36rpx; font-weight: 600; line-height: 1.42; }
.topic-summary { display: -webkit-box; margin-top: 10rpx; overflow: hidden; color: #717974; font-size: 27rpx; line-height: 1.58; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.topic-more { display: flex; width: 100%; margin-top: auto; padding-top: 18rpx; align-items: center; justify-content: space-between; color: #416657; font-size: 26rpx; line-height: 48rpx; }
.topic-more text { font-size: 40rpx; }
