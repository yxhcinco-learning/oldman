<view class="page-shell works-page">
  <view class="brand">岁月有声</view>
  <view class="heading-row">
    <view>
      <view class="eyebrow">本机作品</view>
      <view class="page-title">{{recycle ? '回收站' : '我的作品'}}</view>
    </view>
    <button class="recycle-toggle" bindtap="toggleRecycle">{{recycle ? '返回作品' : '回收站'}}</button>
  </view>
  <view wx:if="{{issue}}" class="error-panel" role="alert">{{issue}}</view>
  <view wx:if="{{loading}}" class="empty-state">正在读取本机作品…</view>
  <view wx:elif="{{visible.length === 0}}" class="empty-state">
    <view class="empty-branch"></view>
    <view class="empty-title">{{recycle ? '回收站是空的' : '还没有作品'}}</view>
    <view>{{recycle ? '移入回收站的作品会完整保留，直到你明确永久删除。' : '点击下方“开始写作”，从想说的一句话开始。作品只保存在当前微信、当前 AppID 和这台设备。'}}</view>
  </view>
  <view class="work-list" wx:else>
    <view class="work-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="continueWriting">
      <view class="cover"><text>{{item.initial}}</text><view></view></view>
      <view class="work-copy">
        <view class="work-title">{{item.title}}</view>
        <view class="work-meta">{{item.meta}}</view>
        <view class="work-actions" wx:if="{{recycle}}">
          <button data-id="{{item.id}}" data-revision="{{item.revision}}" catchtap="restore">恢复</button>
          <button class="danger" data-id="{{item.id}}" data-revision="{{item.revision}}" catchtap="permanentlyDelete">永久删除</button>
        </view>
        <button wx:else class="continue" data-id="{{item.id}}" bindtap="continueWriting">继续写</button>
      </view>
      <button wx:if="{{!recycle}}" class="trash" data-id="{{item.id}}" data-revision="{{item.revision}}" catchtap="moveToRecycle" aria-label="移入回收站">移除</button>
    </view>
  </view>
</view>
<app-nav active="works"></app-nav>
