.publish-page { padding:24px 24px 40px; }
.heading { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.heading button,.cover-actions button,.status-actions button { min-height:48px; padding:10px 12px; background:transparent; color:#416657; font-size:16px; }
.heading .page-title { font-size:26px; line-height:36px; }.publication-state { margin-top:16px; color:#416657; font-size:16px; }
.article-title { margin:24px 0 14px; font-family:"Songti SC",serif; font-size:26px; line-height:38px; overflow-wrap:anywhere; }
.author-row { display:flex; align-items:center; gap:10px; min-height:48px; color:#717974; font-size:16px; flex-wrap:wrap; }
.author-row image { width:32px; height:32px; padding:6px; border-radius:50%; background:#e8eee9; }
.author-row text { overflow-wrap:anywhere; flex:1; min-width:80px; }.author-row button { background:transparent; color:#416657; font-size:14px; min-height:48px; padding:10px 0 10px 8px; }
.section-title { margin:26px 0 16px; font-size:18px; color:#153b2e; font-weight:600; }.choose-empty { width:100%; height:210px; border-radius:16px; background:#e8eee9; color:#416657; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; font-size:18px; }.plus { font-size:36px; }
.crop-tabs { display:flex; gap:8px; margin-bottom:16px; }.crop-tabs button { flex:1; padding:12px 6px; min-height:48px; font-size:14px; color:#717974; background:#f5f3f3; border-radius:24px; }.crop-tabs .selected { background:#e8eee9; color:#153b2e; }
.cover-actions { display:flex; justify-content:center; flex-wrap:wrap; }.reading-cover { display:block; width:100%; height:auto; aspect-ratio:5/4; border-radius:16px; }
.article-body { display:block; font-size:18px; line-height:32px; white-space:pre-wrap; overflow-wrap:anywhere; margin-top:24px; }.ai-label { color:#717974; font-size:14px; margin-top:10px; }
.sample-card { display:flex; gap:16px; padding:16px; border-radius:16px; background:#fff; font-size:18px; line-height:28px; }.sample-card image { width:80px; height:80px; flex-shrink:0; border-radius:12px; }.sample-card text,.sample-share text { color:#717974; font-size:14px; }.sample-card>view { min-width:0; overflow-wrap:anywhere; }
.sample-share { padding:16px; border-radius:16px; background:#fff; font-size:18px; overflow-wrap:anywhere; }.sample-share image { display:block; width:100%; height:auto; aspect-ratio:5/4; margin:12px 0; }
.publish-dock { position:fixed; z-index:10; bottom:0; left:0; right:0; display:flex; gap:12px; padding:12px 24px calc(12px + env(safe-area-inset-bottom)); background:#fbf9f8; border-top:1px solid #e4e6e1; }.publish-dock button { flex:1; min-height:56px; }.footer-space { height:24px; }.publish-page { padding-bottom:calc(116px + env(safe-area-inset-bottom)); }
.reason,.retry-panel { margin-top:16px; padding:16px; background:#f5eee8; border-radius:12px; color:#944924; font-size:16px; line-height:26px; }.retry-panel button,.error-panel button { min-height:48px; color:#416657; font-size:16px; background:transparent; }.progress { font-size:14px; color:#717974; padding:12px 0; }
.result { text-align:center; margin:32px 0; font-size:18px; line-height:32px; }.result image { width:64px; height:64px; padding:16px; background:#e8eee9; border-radius:50%; margin-bottom:20px; }.result button { margin-top:24px; min-height:56px; }.status-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:24px; }
.name-mask { position:fixed; inset:0; z-index:100; background:rgba(27,28,28,.28); display:flex; align-items:center; justify-content:center; padding:24px; }.name-sheet { width:100%; max-width:430px; border-radius:24px; padding:24px; background:#fbf9f8; }.name-sheet .heading { font-size:22px; }
