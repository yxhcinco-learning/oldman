.article-title { flex: 1; min-width: 160px; margin: 0; font-size: 22px; line-height: 32px; }
.work-summary .text-action { padding-right: 0; margin-left: auto; }
.publication-state { margin: 12px 0; color: var(--forest-soft); font-size: 16px; line-height: 26px; }
.article-title { margin: 24px 0 16px; font: 600 28px/40px "Songti SC", serif; color: var(--forest); overflow-wrap: anywhere; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 24px 0 12px; }
.section-title { color: var(--forest); font-size: 18px; font-weight: 600; line-height: 28px; }
.section-heading button { padding-right: 0; }
button.choose-empty { display: flex; width: 100%; min-height: 220px; padding: 28px 16px; flex-direction: column; align-items: center; justify-content: center; gap: 12px; border: 1px dashed #bac9be; border-radius: 16px; background: var(--tint); color: var(--forest); font-size: 18px; line-height: 28px; }
button.choose-empty image { width: 40px; height: 40px; }
.cover-hint { color: var(--forest-soft); font-size: 14px; line-height: 22px; }
.crop-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-bottom: 16px; }
.crop-tabs button { display: flex; width: 100%; min-width: 0; min-height: 64px; padding: 8px 4px; flex-direction: column; align-items: center; justify-content: center; border-radius: 12px; background: var(--surface); color: var(--muted); font-size: 16px; line-height: 26px; }
.crop-tabs .selected { background: var(--tint); color: var(--forest); box-shadow: inset 0 0 0 1px #b9cabe; }
.crop-state { font-size: 14px; line-height: 22px; }
.crop-confirm { margin-top: 16px; }
.confirmed { display: flex; min-height: 56px; gap: 8px; align-items: center; justify-content: center; color: var(--forest-soft); font-size: 16px; }
.confirmed image { width: 20px; height: 20px; }
.latest-cover { margin: 8px auto 0; }
.reading-cover { display: block; width: 100%; border-radius: 16px; background: var(--surface); }
.author-row { display: flex; align-items: center; gap: 8px; min-height: 48px; color: var(--muted); font-size: 16px; line-height: 26px; }
.author-row image { width: 32px; height: 32px; padding: 6px; flex: 0 0 32px; border-radius: 50%; background: var(--tint); }
.author-row > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.author-row button { flex: 0 0 auto; padding: 8px 0 8px 4px; font-size: 14px; }
.article-body { display: block; margin-top: 24px; font-size: 18px; line-height: 32px; white-space: pre-wrap; overflow-wrap: anywhere; }
.ai-label { margin-top: 12px; color: var(--muted); font-size: 14px; line-height: 22px; }
button.examples-toggle { display: flex; width: 100%; min-height: 56px; margin: 32px 0 0; padding: 12px 0; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); border-radius: 0; text-align: left; }
.distribution-examples > .section-title { margin: 20px 0 12px; }
.sample-card { display: flex; gap: 16px; padding: 16px; border-radius: 16px; background: var(--white); font-size: 18px; line-height: 28px; }
.sample-card image { width: 80px; height: 80px; flex: 0 0 80px; border-radius: 12px; }
.sample-card > view { min-width: 0; overflow-wrap: anywhere; }
.sample-card text, .sample-share text { color: var(--muted); font-size: 14px; }
.sample-share { max-width: 360px; padding: 16px; border-radius: 16px; background: var(--white); font-size: 18px; line-height: 28px; overflow-wrap: anywhere; }
.sample-share image { display: block; width: 100%; margin: 12px 0; }
.submission-note { margin-top: 20px; color: var(--muted); font-size: 14px; line-height: 24px; }
.reason, .retry-panel { margin: 16px 0; padding: 16px; background: #f5eee8; border-radius: 12px; color: var(--sienna); font-size: 16px; line-height: 26px; }
.retry-panel button { margin-top: 12px; }
.progress { padding: 8px 0 16px; color: var(--muted); font-size: 14px; line-height: 22px; }
.result-page { padding-top: 32px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.result { text-align: center; }
.result-mark { display: flex; width: 72px; height: 72px; margin: 0 auto 24px; align-items: center; justify-content: center; border-radius: 50%; background: var(--tint); }
.result-mark image { width: 32px; height: 32px; }
.result-title { color: var(--forest); font: 28px/40px "Songti SC", serif; }
.result-copy { margin: 12px auto 24px; max-width: 320px; color: var(--muted); font-size: 16px; line-height: 28px; }
.submitted-work { padding: 20px 0; margin-bottom: 24px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: left; }
.submitted-work > view { color: var(--forest); font: 22px/32px "Songti SC", serif; overflow-wrap: anywhere; }
.submitted-work text { display: block; margin-top: 8px; color: var(--muted); font-size: 14px; line-height: 22px; }
.result-links, .status-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px; margin-top: 12px; }
.status-actions { margin-top: 24px; padding-top: 12px; border-top: 1px solid var(--line); }
.status-actions .danger { color: var(--sienna); }
.name-mask { position: fixed; z-index: 100; top: 0; right: 0; left: 0; display: flex; align-items: flex-end; justify-content: center; background: rgba(28,50,41,.23); backdrop-filter: blur(8px); }
.name-sheet { width: 100%; max-height: 100%; box-sizing: border-box; overflow-y: auto; padding: 20px var(--page-gutter) calc(24px + env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; background: var(--paper); }
.name-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--forest); font: 22px/32px "Songti SC", serif; }
.name-heading button { display: flex; width: 48px; height: 48px; flex: 0 0 48px; margin: 0; padding: 0; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface); }
.name-heading image { width: 20px; height: 20px; }

.publish-page { padding: 20px var(--page-gutter) calc(164px + env(safe-area-inset-bottom)); }
.publish-dock { display: block; padding-top: 8px; }
.submission-note { margin: 0 0 8px; text-align: center; font-size: 14px; line-height: 22px; }
button.cover-entry { display: flex; position: relative; width: 100%; max-width: none; min-height: 196px; margin: 0; padding: 24px 12px; flex-direction: column; align-items: center; justify-content: center; gap: 8px; border-radius: 16px; background: var(--tint); color: var(--forest); font-size: 18px; line-height: 28px; overflow: hidden; }
button.cover-entry.has-cover { padding: 0; min-height: 0; }
.cover-entry .cover-add { width: 36px; height: 36px; margin-bottom: 4px; }
.cover-edit { position: absolute; right: 12px; bottom: 12px; padding: 4px 12px; border-radius: 16px; background: rgba(21,59,46,.85); color: white; font-size: 14px; line-height: 24px; }
.cover-hint { color: var(--forest-soft); font-size: 14px; line-height: 22px; }
.field-hint { margin-top: 12px; color: var(--sienna); font-size: 16px; line-height: 26px; }
.edit-body { margin-top: 16px; padding-left: 0; }
.publication-state { padding-bottom: 16px; color: var(--forest-soft); font-size: 16px; line-height: 26px; }
.publication-state button { padding-left: 0; }
.result-page { padding-top: 32px; padding-bottom: 32px; }
.result-mark { width: 48px; height: 48px; margin-bottom: 16px; }
.result-mark image { width: 24px; height: 24px; }
.result-detail { margin: 12px auto 0; }
.review-status { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--line); color: var(--forest-soft); font-size: 16px; line-height: 26px; }
.review-status .section-title { margin-bottom: 8px; }
.submission-time { margin-top: 12px; font-size: 14px; color: var(--muted); }
.review-note { margin-top: 32px; color: var(--muted); font-size: 16px; line-height: 26px; }
.sample-card text { display: block; margin-top: 8px; }
.crop-screen { display: flex; flex-direction: column; width: 100%; background: #17211c; color: white; overflow: hidden; box-sizing: border-box; }
.crop-screen .journey-header { flex: 0 0 auto; }
.crop-stage { display: flex; min-height: 0; flex: 1; padding: 4px var(--page-gutter); flex-direction: column; justify-content: center; align-items: center; }
.crop-error { max-height: 60px; overflow-y: auto; margin-bottom: 8px; color: #f2b794; font-size: 14px; line-height: 20px; }
.crop-choices { display: flex; gap: 20px; justify-content: center; padding: 8px var(--page-gutter) 0; flex: 0 0 auto; }
button.crop-choice { display: flex; width: 132px; min-width: 0; min-height: 112px; flex-direction: column; align-items: center; justify-content: center; padding: 6px; gap: 4px; margin: 0; border: 1px solid transparent; border-radius: 12px; background: transparent; color: #b5c2b9; font-size: 16px; line-height: 24px; }
button.crop-choice.selected { color: white; border-color: #91bda1; background: #25372c; }
.crop-mini { height: 56px; border-radius: 4px; overflow: hidden; }
.crop-ratio { font-size: 12px; line-height: 16px; color: #b5c2b9; }
.crop-bottom { display: flex; flex: 0 0 auto; align-items: center; justify-content: space-between; gap: 24px; padding: 12px var(--page-gutter) calc(16px + env(safe-area-inset-bottom)); }
button.crop-cancel { min-height: 56px; width: auto; margin: 0; padding: 8px 0; background: transparent; color: #e0e8e2; font-size: 18px; }
button.crop-done { width: 144px; min-height: 56px; margin: 0; padding: 8px 20px; border-radius: 28px; background: #dcebe1; color: #153b2e; font-size: 18px; }
