.publish-page { padding: 8px var(--page-gutter) calc(32px + env(safe-area-inset-bottom)); }
.settings-page { padding-bottom: calc(144px + env(safe-area-inset-bottom)); }
.publish-dock { display: block; padding-top: 10px; border-top: 0; }
.submission-note { margin: 0 0 10px; text-align: center; color: var(--muted); font-size: 14px; line-height: 22px; }
.publication-document { display: flex; align-items: baseline; gap: 12px; margin: 4px 0 20px; }
.document-title { flex: 1; min-width: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; color: var(--forest); font: 600 21px/32px "Songti SC", serif; }
.publication-document > text { flex: 0 0 auto; color: var(--muted); font-size: 14px; line-height: 22px; white-space: nowrap; }
button.cover-entry { display: flex; position: relative; width: 100%; max-width: none; min-height: 0; margin: 0; padding: 24px 12px; flex-direction: column; align-items: center; justify-content: center; gap: 8px; border: 1px solid #e7e9e2; border-radius: 16px; background: #f0f1ec; color: var(--forest-soft); font-size: 18px; line-height: 28px; overflow: hidden; }
button.cover-entry.has-cover { padding: 0; border: 0; }
.cover-visual { display: block; flex: none; width: 100%; height: 100%; }
.cover-entry .cover-add { width: 30px; height: 30px; margin-bottom: 4px; opacity: .65; }
.cover-edit { position: absolute; right: 12px; bottom: 12px; padding: 4px 12px; border-radius: 20px; background: rgba(21,59,46,.9); color: white; font-size: 14px; line-height: 24px; }
.cover-hint { color: var(--muted); font-size: 14px; line-height: 22px; }
.cover-validation { min-height: 8px; padding-top: 8px; color: var(--sienna); font-size: 14px; line-height: 22px; }
button.publication-option { display: flex; width: 100%; min-height: 72px; padding: 12px 0; align-items: center; gap: 12px; border-radius: 0; color: var(--ink); text-align: left; font-size: 18px; line-height: 28px; }
.publication-option .option-value { flex: 1; min-width: 0; color: var(--forest-soft); font-size: 17px; text-align: right; overflow-wrap: anywhere; }
.option-chevron { flex: 0 0 8px; width: 8px; height: 8px; margin: 0 4px; border-top: 1.5px solid var(--forest-soft); border-right: 1.5px solid var(--forest-soft); transform: rotate(45deg); }
button.creation-option { font-size: 16px; }
.creation-option .option-value { font-size: 15px; color: var(--muted); }
.option-info { width: 16px; height: 16px; flex: 0 0 16px; border: 1px solid var(--muted); border-radius: 50%; color: var(--muted); font: 13px/16px Georgia, serif; text-align: center; }
.reading-cover { display: block; width: 100%; border-radius: 16px; background: var(--surface); }
.article-title { margin: 24px 0 16px; color: var(--forest); font: 600 28px/40px "Songti SC", serif; overflow-wrap: anywhere; }
.author-row { display: flex; align-items: center; gap: 8px; min-height: 48px; color: var(--muted); font-size: 16px; line-height: 26px; }
.author-row image { width: 32px; height: 32px; padding: 6px; flex: 0 0 32px; border-radius: 50%; background: var(--tint); }
.author-row > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.article-body { display: block; margin-top: 24px; font-size: 18px; line-height: 32px; white-space: pre-wrap; overflow-wrap: anywhere; }
.ai-label { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; line-height: 22px; }
.publication-state { padding-bottom: 16px; color: var(--forest-soft); font-size: 16px; line-height: 26px; }
.publication-state button { padding-left: 0; }
.reason, .retry-panel { margin: 16px 0; padding: 16px; background: #f5eee8; border-radius: 12px; color: var(--sienna); font-size: 16px; line-height: 26px; }
.retry-panel button { margin-top: 12px; }
.progress { padding: 8px 0 16px; color: var(--muted); font-size: 14px; line-height: 22px; }
.result-page { padding-top: 32px; }
.result { text-align: center; }
.result-mark { display: flex; width: 48px; height: 48px; margin: 0 auto 16px; align-items: center; justify-content: center; border-radius: 50%; background: var(--tint); }
.result-mark image { width: 24px; height: 24px; }
.result-title { color: var(--forest); font-size: 28px; line-height: 40px; font-weight: 500; }
.result-copy { margin: 12px auto 24px; max-width: 320px; color: var(--muted); font-size: 16px; line-height: 28px; }
.submitted-work { padding: 20px 0; margin-bottom: 24px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: left; }
.submitted-work > view { color: var(--forest); font: 22px/32px "Songti SC", serif; overflow-wrap: anywhere; }
.submitted-work text { display: block; margin-top: 8px; color: var(--muted); font-size: 14px; line-height: 22px; }
.result-detail { margin: 12px auto 0; }
.result-links, .status-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px; margin-top: 12px; }
.status-actions { margin-top: 24px; padding-top: 12px; }
.status-actions .danger { color: var(--sienna); }
.review-status { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--line); color: var(--forest-soft); font-size: 16px; line-height: 26px; }
.review-status .section-title { margin-bottom: 8px; color: var(--forest); font-size: 18px; font-weight: 600; line-height: 28px; }
.submission-time { margin-top: 12px; font-size: 14px; color: var(--muted); }
.review-note { margin-top: 32px; color: var(--muted); font-size: 16px; line-height: 26px; }
.name-mask { position: fixed; z-index: 100; top: 0; right: 0; left: 0; display: flex; align-items: flex-end; justify-content: center; background: rgba(28,50,41,.23); backdrop-filter: blur(8px); }
.name-sheet { width: 100%; max-height: 100%; box-sizing: border-box; overflow-y: auto; padding: 20px var(--page-gutter) calc(24px + env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; background: var(--paper); }
.name-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--forest); font-size: 22px; line-height: 32px; font-weight: 500; }
.name-heading button { display: flex; width: 48px; height: 48px; flex: 0 0 48px; margin: 0; padding: 0; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface); }
.name-heading image { width: 20px; height: 20px; }

.crop-screen { display: flex; flex-direction: column; width: 100%; background: #17211c; color: white; overflow: hidden; box-sizing: border-box; }
.crop-screen .journey-header { flex: 0 0 auto; }
.crop-stage { display: flex; min-height: 0; flex: 1; padding: 8px var(--page-gutter); flex-direction: column; justify-content: center; align-items: center; overflow-y: auto; }
.publication-cropper { display: block; width: 100%; flex: 0 0 auto; }
.crop-error { max-height: 60px; overflow-y: auto; margin-bottom: 8px; color: #f2b794; font-size: 14px; line-height: 20px; }
.crop-choices { display: flex; gap: 20px; justify-content: center; padding: 8px var(--page-gutter) 0; flex: 0 0 auto; }
.crop-choice { display: flex; box-sizing: border-box; width: 132px; min-width: 0; min-height: 112px; flex-direction: column; align-items: center; justify-content: center; padding: 6px; gap: 4px; margin: 0; border: 1px solid transparent; border-radius: 12px; background: transparent; color: #b5c2b9; font-size: 16px; line-height: 24px; }
.crop-mini { height: 56px; border-radius: 4px; overflow: hidden; }
.crop-ratio { font-size: 12px; line-height: 16px; color: #b5c2b9; }
.crop-bottom { display: flex; flex: 0 0 auto; align-items: center; gap: 12px; padding: 12px var(--page-gutter) max(18px, env(safe-area-inset-bottom)); border-top: 1px solid rgba(255,255,255,.1); }
button.crop-cancel, button.crop-done { box-sizing: border-box; width: 0; min-width: 0; max-width: none; flex: 1 1 0; height: 48px; min-height: 48px; margin: 0; padding: 0 12px; border-radius: 24px; font-size: 16px; font-weight: 500; line-height: 46px; }
button.crop-cancel { border: 1px solid #657b6c; background: transparent; color: #e0e8e2; }
button.crop-done { border: 1px solid transparent; background: #e2eee5; color: #153b2e; }
@media (max-height: 690px) {
  .crop-stage { padding-top: 0; padding-bottom: 4px; }
  .crop-bottom { padding-top: 8px; padding-bottom: max(12px, env(safe-area-inset-bottom)); }
}
