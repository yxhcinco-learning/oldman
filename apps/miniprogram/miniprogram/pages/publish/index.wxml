<block wx:if="{{accountReady}}">
<page-header class="journey-header" title="{{mode === 'preview' ? '文章预览' : mode === 'result' ? '发表详情' : '发表文章'}}" />
<view class="publish-page {{mode === 'result' ? 'result-page' : ''}}">
  <view wx:if="{{mode !== 'result'}}" class="publication-steps" aria-label="{{mode === 'settings' ? '第一步：选择封面' : '第二步：预览文章'}}"><text class="{{mode === 'settings' ? 'current' : ''}}">1 选封面</text><view /><text class="{{mode === 'preview' ? 'current' : ''}}">2 看预览</text><view /><text>3 提交审核</text></view>
  <view wx:if="{{error}}" class="error-panel" role="alert">{{error}}<button wx:if="{{mode === 'settings'}}" class="text-action" bindtap="refresh" disabled="{{busy}}">重试读取</button></view>
  <view wx:if="{{busy}}" class="progress" role="status">{{busy}}</view>
  <view wx:if="{{pendingRetry}}" class="retry-panel"><text>上次投稿结果尚未确认</text><button class="secondary-action" bindtap="submit" disabled="{{busy}}">重试提交</button></view>
  <view wx:if="{{actionRetry}}" class="retry-panel"><text>上次撤回结果尚未确认</text><button class="secondary-action" bindtap="retryAction" disabled="{{busy}}">重试撤回</button></view>
  <block wx:if="{{mode === 'settings'}}">
    <view class="work-summary"><view class="article-title">{{title || '未命名文章'}}</view><button class="text-action" bindtap="backToEditor">修改正文 <text aria-hidden="true">›</text></button></view>
    <view wx:if="{{status.published}}" class="publication-state">修改审核通过前，读者仍会看到原来的文章。</view>
    <view wx:if="{{status.lastSubmission.state === 'rejected'}}" class="reason">未通过原因：{{status.lastSubmission.reason}}</view>
    <view wx:elif="{{status.reason}}" class="reason">{{status.reason}}</view>
    <view class="section-heading"><view class="section-title">文章封面</view><button wx:if="{{draft.path}}" class="text-action" bindtap="chooseCover" disabled="{{busy || readOnly || pendingRetry || actionRetry || draft.settingOperation}}">更换图片</button></view>
    <button wx:if="{{!draft.path}}" class="choose-empty" bindtap="chooseCover" disabled="{{busy || readOnly}}"><image src="/assets/image.svg" mode="aspectFit" /><text>选一张照片做封面</text><text class="cover-hint">从相册选择，也可以拍一张</text></button>
    <block wx:else>
      <view class="crop-tabs" role="tablist">
        <button class="{{cropKind === 'thumbnail' ? 'selected' : ''}}" data-kind="thumbnail" bindtap="changeCropKind" role="tab" aria-selected="{{cropKind === 'thumbnail'}}"><text>列表封面 · 1:1</text><text class="crop-state">{{thumbnailConfirmed ? '已确认' : '待确认'}}</text></button>
        <button class="{{cropKind === 'reading' ? 'selected' : ''}}" data-kind="reading" bindtap="changeCropKind" role="tab" aria-selected="{{cropKind === 'reading'}}"><text>阅读与分享 · 5:4</text><text class="crop-state">{{readingConfirmed ? '已确认' : '待确认'}}</text></button>
      </view>
      <cover-cropper class="publication-cropper" wx:if="{{draft.width && draft.height && !draft.settingOperation && !pendingRetry && !actionRetry}}" src="{{draft.path}}" source-width="{{draft.width}}" source-height="{{draft.height}}" crop="{{crop}}" ratio="{{ratio}}" viewport-width="{{cropWidth}}" bindchange="cropChanged" />
      <view class="crop-confirm" wx:if="{{!draft.settingOperation && !pendingRetry && !actionRetry}}">
        <view wx:if="{{cropConfirmed}}" class="confirmed"><image src="/assets/check.svg" /><text>这张封面已确认</text></view>
        <button wx:else class="secondary-action" bindtap="confirmCrop" disabled="{{busy || readOnly}}">{{cropKind === "thumbnail" ? "用作列表封面" : "用作阅读与分享封面"}}</button>
      </view>
      <button wx:if="{{error && status.settings.assetId}}" class="text-action latest-cover" bindtap="useLatestCover" disabled="{{busy}}">使用最新封面</button>
    </block>
    <view wx:if="{{status.published}}" class="status-actions"><button class="text-action" bindtap="readArticle">查看已发表文章</button><button class="text-action danger" data-action="withdraw" bindtap="withdraw" disabled="{{busy || readOnly}}">撤回发表</button></view>
  </block>
  <block wx:elif="{{mode === 'preview' && preview}}">
    <view class="reader"><image class="reading-cover" style="height: {{viewportWidth * 0.8}}px" src="{{image}}" mode="aspectFit" /><view class="article-title">{{preview.title}}</view>
      <view class="author-row"><image src="/assets/leaf.svg" /><text>{{preview.authorName}}</text><button class="text-action" bindtap="editName" disabled="{{busy}}">修改用户名</button></view>
      <view wx:if="{{preview.aiAssisted}}" class="ai-label">本文包含 AI 辅助创作内容</view><text class="article-body" user-select>{{preview.body}}</text>
    </view>
    <button class="examples-toggle" bindtap="toggleExamples" aria-expanded="{{showExamples}}"><text>{{showExamples ? '收起列表和分享效果' : '查看列表和分享效果'}}</text><text aria-hidden="true">{{showExamples ? '−' : '＋'}}</text></button>
    <view wx:if="{{showExamples}}" class="distribution-examples">
      <view class="section-title">在文章列表中</view><view class="sample-card"><image src="{{thumbnail}}" /><view><view>{{preview.title}}</view><text>{{preview.authorName}}</text></view></view>
      <view class="section-title">分享给好友时</view><view class="sample-share"><view>{{preview.title}}</view><image src="{{image}}" mode="widthFix" /><text>岁月有声</text></view>
    </view>
    <view class="submission-note">提交后由人工审核，通过后才会公开。</view>
  </block>
  <view wx:elif="{{mode === 'result'}}" class="result">
    <view class="result-mark"><image src="/assets/check.svg" /></view>
    <view class="result-title">{{status.pending ? '已提交审核' : status.published ? '文章已发表' : '投稿状态已更新'}}</view>
    <view class="result-copy">{{status.pending ? '通过审核后，大家就能读到这篇文章。' : status.published ? '现在可以邀请好友来读一读。' : '回到我的文章，查看最新状态。'}}</view>
    <view class="submitted-work"><view>{{title}}</view><text>{{statusLabel}}</text></view>
    <view wx:if="{{status.pending}}" class="result-copy">继续修改不会改变这次投稿。要提交修改后的文章，请先撤回审核。</view>
    <view wx:if="{{status.pending && status.published}}" class="publication-state">本次修改正在审核，原来的文章仍可阅读。</view>
    <button class="primary-action" bindtap="myArticles">回到我的文章</button>
    <view class="result-links"><button class="text-action" bindtap="backToEditor">继续修改正文</button><button wx:if="{{status.published}}" class="text-action" bindtap="readArticle">查看已发表文章</button></view>
    <view class="status-actions"><button wx:if="{{status.pending}}" class="text-action danger" data-action="withdraw-review" bindtap="withdraw" disabled="{{busy || readOnly}}">撤回审核</button><button wx:if="{{status.published}}" class="text-action danger" data-action="withdraw" bindtap="withdraw" disabled="{{busy || readOnly}}">撤回发表</button></view>
  </view>
</view>
<view wx:if="{{mode !== 'result' && !status.pending && !pendingRetry && !actionRetry}}" class="page-actions publish-dock">
  <button wx:if="{{mode === 'settings'}}" class="primary-action" bindtap="preparePreview" disabled="{{busy || readOnly || !draft.path}}">预览文章</button>
  <block wx:else><button class="secondary-action" bindtap="settings" disabled="{{busy}}">调整封面</button><button class="primary-action" bindtap="submit" disabled="{{busy || readOnly || !preview}}">提交审核</button></block>
</view>
<view wx:if="{{editingName}}" class="name-mask" style="bottom: {{nameKeyboardHeight}}px" catchtap="closeName" catchtouchmove="noop">
  <view class="name-sheet" catchtap="noop" role="dialog" aria-modal="true" aria-label="修改用户名">
    <view class="name-heading"><view>修改用户名</view><button bindtap="closeName" aria-label="关闭"><image src="/assets/close.svg" /></button></view>
    <username-editor class="publication-username" value="{{authorName}}" bindsaved="nameSaved" bindkeyboard="nameKeyboard" />
  </view>
</view>
</block>
