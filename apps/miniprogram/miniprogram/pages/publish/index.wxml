<block wx:if="{{accountReady}}">
<view wx:if="{{mode === 'crop'}}" class="crop-screen" style="height: {{windowHeight}}px">
  <page-header class="journey-header" title="调整封面" dark="{{true}}" intercept-back="{{true}}" bindback="back" />
  <view class="crop-stage">
    <view wx:if="{{error}}" class="crop-error" role="alert">{{error}}</view>
    <cover-cropper class="publication-cropper" wx:if="{{draft.width && draft.height}}" dark="{{true}}" disabled="{{!!busy}}" src="{{draft.path}}" source-width="{{draft.width}}" source-height="{{draft.height}}" crop="{{crop}}" ratio="{{ratio}}" viewport-width="{{cropWidth}}" bindchanging="cropChanging" bindchange="cropChanged" />
  </view>
  <view class="crop-choices" aria-label="两种封面实际效果">
    <view class="crop-choice">
      <view class="crop-mini" style="width: 70px"><article-cover src="{{draft.path}}" crop="{{cropPreviews.reading}}" width="{{70}}" ratio="{{1.25}}" /></view>
      <text>阅读与分享</text><text class="crop-ratio">5:4</text>
    </view>
    <view class="crop-choice">
      <view class="crop-mini" style="width: 56px"><article-cover src="{{draft.path}}" crop="{{cropPreviews.thumbnail}}" width="{{56}}" ratio="{{1}}" /></view>
      <text>文章列表</text><text class="crop-ratio">1:1</text>
    </view>
  </view>
  <view class="crop-bottom"><button class="crop-cancel" bindtap="cancelCrop" disabled="{{busy}}">取消</button><button class="crop-done" bindtap="confirmCrop" disabled="{{busy || readOnly}}">{{busy ? '保存中…' : '完成'}}</button></view>
</view>
<block wx:else>
<page-header class="journey-header" title="{{mode === 'settings' ? '发表设置' : mode === 'preview' ? '阅读预览' : mode === 'result' ? '提交结果' : '审核详情'}}" action-text="{{mode === 'settings' ? '预览' : ''}}" action-disabled="{{!!busy || readOnly || pendingRetry || actionRetry}}" bind:action="preparePreview" intercept-back="{{true}}" bindback="back" />
<view class="publish-page {{mode === 'settings' ? 'settings-page' : ''}} {{mode === 'result' ? 'result-page' : ''}}">
  <view wx:if="{{error}}" class="error-panel" role="alert"><text>{{error}}</text><button class="text-action" bindtap="retry" disabled="{{busy}}">重试</button><button wx:if="{{status.settings.assetId && mode === 'settings' && !pendingRetry && !actionRetry}}" class="text-action" bindtap="useLatestCover" disabled="{{busy}}">使用最新封面</button></view>
  <view wx:if="{{busy}}" class="progress" role="status">{{busy}}</view>
  <view wx:if="{{pendingRetry}}" class="retry-panel"><text>上次投稿结果尚未确认</text><button class="primary-action" bindtap="submit" disabled="{{busy}}">确认投稿结果</button></view>
  <view wx:if="{{actionRetry}}" class="retry-panel"><text>上次撤回结果尚未确认</text><button class="secondary-action" bindtap="retryAction" disabled="{{busy}}">重试撤回</button></view>
  <view wx:if="{{audiencePending}}" class="retry-panel"><text>阅读范围尚未确认</text><button class="text-action" bindtap="retryAudience" disabled="{{busy}}">核对上次修改</button></view>
  <block wx:if="{{mode === 'settings'}}">
    <view wx:if="{{status.lastSubmission.state === 'rejected'}}" class="reason">审核未通过：{{status.lastSubmission.reason}}</view>
    <view wx:elif="{{status.reason}}" class="reason">{{status.reason}}</view>
    <view wx:if="{{status.published}}" class="publication-state"><text>修改通过审核前，读者仍会看到原来的文章。</text><button class="text-action" bindtap="readArticle">查看公开文章 ›</button></view>
    <view class="publication-document"><view class="document-title">{{title || '未填写标题'}}</view><text>{{wordCount}} 字</text></view>
    <button class="cover-entry {{draft.path ? 'has-cover' : ''}}" style="height: {{viewportWidth * 0.8}}px" bindtap="coverOptions" disabled="{{busy || readOnly || pendingRetry || actionRetry}}" aria-label="{{draft.path ? '调整或更换封面' : '添加文章封面'}}">
      <block wx:if="{{draft.path}}"><article-cover class="cover-visual" src="{{draft.path}}" crop="{{draft.crops.reading}}" width="{{viewportWidth}}" ratio="{{1.25}}" /><text class="cover-edit">调整封面</text></block>
      <block wx:else><image class="cover-add" src="/assets/image.svg" /><text>添加封面</text><text class="cover-hint">选择一张与文章有关的照片</text></block>
    </button>
    <view class="cover-validation" role="status">{{coverError || (draft.path && (!readingConfirmed || !thumbnailConfirmed) ? '请点击封面，完成调整。' : '')}}</view>
    <button class="publication-option" bindtap="editName" disabled="{{busy || readOnly || pendingRetry || actionRetry}}" aria-label="修改署名"><text>署名</text><text class="option-value">{{authorName}}</text><view class="option-chevron" aria-hidden="true" /></button>
    <button class="publication-option" bindtap="chooseAudience" disabled="{{busy || readOnly || pendingRetry || audiencePending}}" aria-label="修改阅读范围"><text>阅读范围</text><text class="option-value">{{audience === 'guest' ? '所有人可读' : '登录后可读'}}</text><view class="option-chevron" aria-hidden="true" /></button>
    <button wx:if="{{aiAssisted}}" class="publication-option creation-option" bindtap="explainAi"><text>创作方式</text><text class="option-value">AI 辅助整理</text><text class="option-info" aria-hidden="true">i</text></button>
    <view wx:if="{{status.published}}" class="status-actions"><button class="text-action danger" data-action="withdraw" bindtap="withdraw" disabled="{{busy || readOnly || pendingRetry || actionRetry}}">撤回发表</button></view>
  </block>
  <block wx:elif="{{mode === 'preview' && preview}}">
    <image class="reading-cover" style="height: {{viewportWidth * 0.8}}px" src="{{image}}" mode="aspectFit" />
    <view class="article-title">{{preview.title}}</view>
    <view class="author-row"><image src="/assets/leaf.svg" /><text>{{preview.authorName}}</text></view>
    <text class="article-body" user-select>{{preview.body}}</text>
    <view wx:if="{{preview.aiAssisted}}" class="ai-label">本文含 AI 辅助整理内容</view>
  </block>
  <view wx:elif="{{mode === 'result'}}" class="result">
    <view class="result-mark"><image src="/assets/check.svg" /></view><view class="result-title">已提交审核</view>
    <view class="result-copy">审核通过后，其他人就能阅读这篇文章。</view>
    <view class="submitted-work"><view>{{submission.title || '投稿已收到'}}</view><text>{{notice || '可以在“我的”查看审核状态。'}}</text></view>
    <button class="primary-action" bindtap="myArticles">完成</button><button class="text-action result-detail" bindtap="showSubmission">查看本次投稿 ›</button>
  </view>
  <block wx:elif="{{mode === 'review'}}">
    <view class="review-status"><view class="section-title">{{statusLabel}}</view><view wx:if="{{status.pending}}">审核通过后，这篇投稿才会公开。</view><view wx:if="{{status.pending && status.published}}">原来的公开文章仍可阅读。</view><view wx:if="{{submission}}" class="submission-time">提交于 {{submissionDate}}</view></view>
    <button wx:if="{{status.published}}" class="publication-option" bindtap="chooseAudience" disabled="{{busy || readOnly || pendingRetry || audiencePending}}" aria-label="修改阅读范围"><text>阅读范围</text><text class="option-value">{{audience === 'guest' ? '所有人可读' : '登录后可读'}}</text><view class="option-chevron" aria-hidden="true" /></button>
    <view wx:if="{{status.lastSubmission.reason}}" class="reason">{{status.lastSubmission.reason}}</view>
    <block wx:if="{{submission}}"><image class="reading-cover" style="height: {{viewportWidth * 0.8}}px" src="{{image}}" mode="aspectFit" /><view class="article-title">{{submission.title}}</view><view class="author-row"><image src="/assets/leaf.svg" /><text>{{submission.authorName}}</text></view><text class="article-body" user-select>{{submission.body}}</text><view wx:if="{{submission.aiAssisted}}" class="ai-label">本文含 AI 辅助整理内容</view></block>
    <view class="review-note">继续编辑会保留为修改稿，不会改变这次投稿。</view>
    <view class="result-links"><button class="text-action" bindtap="backToEditor">编辑文章</button><button wx:if="{{status.published}}" class="text-action" bindtap="readArticle">查看公开文章</button></view>
    <view class="status-actions"><button wx:if="{{status.pending}}" class="text-action danger" data-action="withdraw-review" bindtap="withdraw" disabled="{{busy || readOnly}}">撤回审核</button><button wx:if="{{status.published}}" class="text-action danger" data-action="withdraw" bindtap="withdraw" disabled="{{busy || readOnly}}">撤回发表</button></view>
  </block>
</view>
<view wx:if="{{mode === 'settings' && !pendingRetry && !actionRetry}}" class="page-actions publish-dock"><view class="submission-note">审核通过后，文章才会公开</view><button class="primary-action" bindtap="submit" disabled="{{busy || readOnly}}">{{busy ? '请稍候…' : '提交审核'}}</button></view>
</block>
<view wx:if="{{editingName}}" class="name-mask" style="top: {{navigationHeight}}px; bottom: {{nameKeyboardHeight}}px" catchtap="closeName" catchtouchmove="noop"><view class="name-sheet" catchtap="noop" role="dialog" aria-modal="true" aria-label="修改用户名"><view class="name-heading"><view>修改用户名</view><button bindtap="closeName" aria-label="关闭"><image src="/assets/close.svg" /></button></view><username-editor class="publication-username" value="{{authorName}}" bindsaved="nameSaved" bindkeyboard="nameKeyboard" /></view></view>
</block>
