<block wx:if="{{accountReady}}"><page-header title="我的收藏" />
<view class="social-page">
  <view wx:if="{{error}}" class="error-panel" role="alert">{{error}}<button wx:if="{{needsLogin}}" class="text-action" bindtap="login">微信登录</button><button wx:else class="text-action" bindtap="refresh">重新读取</button></view>
  <view wx:if="{{loading}}" class="social-empty-compact">正在读取收藏…</view>
  <view wx:for="{{collections}}" wx:key="articleId" class="social-article">
    <button wx:if="{{item.available && item.article}}" class="social-article-open" data-id="{{item.articleId}}" bindtap="openArticle"><view class="social-article-copy"><view class="social-article-title">{{item.article.title}}</view><view class="social-article-excerpt">{{item.article.excerpt}}</view></view><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" /></button>
    <view wx:else class="unavailable-collection"><image src="/assets/book.svg" /><text>这篇文章暂时无法查看</text></view>
    <view class="social-article-meta"><text>{{item.available ? item.article.authorName + ' · ' + item.date : ''}}</text><button class="social-icon-button" bindtap="removeCollection" data-id="{{item.articleId}}" disabled="{{busy}}" aria-label="取消收藏"><image src="/assets/social-star.svg" /></button></view>
  </view>
  <view wx:if="{{!loading && !error && !collections.length}}" class="social-empty"><image src="/assets/social-star.svg" /><view class="social-empty-title">还没有收藏文章</view><view class="social-empty-copy">阅读时点一下收藏，之后可以从这里找到。</view><button class="secondary-action" bindtap="readArticles">去读一篇文章</button></view>
  <button wx:if="{{cursor}}" class="text-action" bindtap="more" disabled="{{moreLoading}}">{{moreLoading ? '正在读取…' : '更多收藏'}}</button><view wx:elif="{{collections.length}}" class="list-end">已读完</view>
</view></block>
