.articles-page { padding-bottom: calc(100px + env(safe-area-inset-bottom)); }
.articles-heading { display: flex; min-width: 0; margin: 28px 0 8px; align-items: center; justify-content: space-between; gap: 16px; }
.articles-heading .page-title { flex: 1; min-width: 0; }
button.write-entry { display: flex; width: auto; min-width: 48px; min-height: 48px; flex: 0 0 auto; margin: 0 -8px 0 0; padding: 8px; gap: 8px; align-items: center; justify-content: center; background: transparent; color: var(--forest-soft); font-size: 16px; line-height: 26px; }
.write-entry image { width: 20px; height: 20px; }
.public-card { display: flex; align-items: flex-start; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--line); }
.card-cover, .image-placeholder { width: 88px; height: 88px; flex-shrink: 0; border-radius: 12px; }
.image-placeholder { background: var(--tint); display: flex; justify-content: center; align-items: center; }
.image-placeholder image { width: 32px; height: 32px; opacity: .6; }
.card-copy { min-width: 0; flex: 1; }
.card-title { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; color: var(--forest); font-family: "Songti SC",serif; font-size: 22px; line-height: 32px; overflow-wrap: anywhere; }
.card-excerpt { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-top: 8px; color: var(--muted); font-size: 16px; line-height: 26px; overflow-wrap: anywhere; }
.card-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 12px; font-size: 14px; line-height: 22px; color: var(--muted); }
.card-author { overflow-wrap: anywhere; }
.card-date { white-space: nowrap; }
.articles-empty { padding: 48px 0; text-align: center; }
.empty-drawing { display: block; width: 144px; height: 128px; margin: 0 auto 24px; }
.empty-title { color: var(--forest); font-family: "Songti SC",serif; font-size: 20px; line-height: 32px; }
.articles-empty text { display: block; margin-top: 8px; color: var(--muted); font-size: 16px; line-height: 26px; }
.articles-loading { padding: 24px; color: var(--muted); text-align: center; }
button.load-more { display: flex; width: 100%; max-width: 100%; min-width: 0; min-height: 48px; margin: 8px 0; padding: 12px; align-items: center; justify-content: center; color: var(--forest-soft); background: transparent; font-size: 16px; }
@media (max-width: 370px) { .public-card { gap: 16px; } .card-cover, .image-placeholder { width: 80px; height: 80px; } }
