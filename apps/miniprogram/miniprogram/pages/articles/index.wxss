.articles-page { padding-bottom:calc(180px + env(safe-area-inset-bottom)); }.articles-heading { display:flex; align-items:center; justify-content:space-between; margin:24px 0; }.articles-heading button { min-height:48px; padding:10px 16px; color:#416657; background:transparent; font-size:16px; }
.public-card { display:flex; gap:16px; padding:20px; margin-bottom:16px; background:#fff; border-radius:16px; box-shadow:0 6px 20px rgba(21,59,46,.04); }.public-card>image,.image-placeholder { width:96px; height:96px; flex-shrink:0; border-radius:12px; }.image-placeholder { background:#e8eee9; display:flex; justify-content:center; align-items:center; }.image-placeholder image { width:36px; height:36px; }.card-copy { min-width:0; flex:1; }.card-title { font-family:"Songti SC",serif; font-size:20px; line-height:30px; overflow-wrap:anywhere; }.card-author { display:flex; align-items:center; gap:6px; margin-top:8px; font-size:14px; color:#717974; }.card-author image { width:22px; height:22px; padding:3px; background:#e8eee9; border-radius:50%; flex-shrink:0; }.card-author text { overflow-wrap:anywhere; }.card-date { margin-top:6px; font-size:14px; color:#717974; }.articles-empty { padding:64px 12px; text-align:center; font-size:20px; line-height:32px; }.articles-empty text { display:block; font-size:16px; color:#717974; margin-top:12px; }.articles-loading { padding:20px; color:#717974; text-align:center; }.load-more { min-height:56px; color:#416657; background:#e8eee9; font-size:16px; border-radius:28px; }.writing-dock { position:fixed; z-index:10; bottom:calc(76px + env(safe-area-inset-bottom)); left:24px; right:24px; }.writing-dock button { min-height:56px; }
@media(max-width:370px) { .public-card { padding:16px; gap:12px; }.public-card>image,.image-placeholder { width:80px; height:80px; } }
