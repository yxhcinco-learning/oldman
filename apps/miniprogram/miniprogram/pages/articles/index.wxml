<block wx:if="{{accountReady}}">
<view class="page-shell articles-page"><app-brand /><view class="articles-heading"><view class="page-title">文章</view><button bindtap="refresh" disabled="{{loading}}">刷新</button></view>
  <view wx:if="{{error}}" class="error-panel" role="alert">{{error}}</view>
  <view wx:if="{{!loading && !cards.length && !error}}" class="articles-empty"><view>还没有发表的文章</view><text>写下想与大家分享的故事。</text></view>
  <view class="public-card" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="open" role="button" aria-label="{{'阅读：' + item.title}}">
    <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" /><view wx:else class="image-placeholder"><image src="/assets/book.svg" /></view>
    <view class="card-copy"><view class="card-title">{{item.title}}</view><view class="card-author"><image src="/assets/leaf.svg" /><text>{{item.authorName}}</text></view><view class="card-date">{{item.date}}</view></view>
  </view>
  <view wx:if="{{loading}}" class="articles-loading" role="status">正在读取文章…</view><button wx:elif="{{cursor}}" class="load-more" bindtap="more">查看更多文章</button>
</view><view class="writing-dock"><button class="primary-action" bindtap="write">写文章</button></view></block>
