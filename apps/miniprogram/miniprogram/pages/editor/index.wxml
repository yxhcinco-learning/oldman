<view class="editor-page" style="padding-bottom: {{keyboardHeight}}px">
  <view class="editor-topbar">
    <button class="back" bindtap="goBack" aria-label="返回">‹</button>
    <button class="title-button {{draft && !draft.title ? 'empty' : ''}}" bindtap="openTitle">
      <text>{{draft && draft.title ? draft.title : '点击编辑标题'}}</text>
    </button>
    <button class="save" bindtap="saveNow" disabled="{{saving}}">{{saving ? '保存中' : '保存'}}</button>
  </view>

  <view wx:if="{{error}}" class="editor-error" role="alert">
    <scroll-view scroll-y class="error-copy">{{error}}</scroll-view>
    <view class="error-actions"><button bindtap="saveNow">重试保存</button><button bindtap="exportRescue">救援导出</button></view>
  </view>
  <view wx:if="{{notice}}" class="editor-notice" role="status">{{notice}}</view>

  <view wx:if="{{draft && draft.topicSnapshot}}" class="topic-background">
    <button class="topic-heading" bindtap="toggleTopic"><text>文章背景</text><text>{{topicOpen ? '收起' : '展开'}}</text></button>
    <view wx:if="{{topicOpen}}" class="topic-body">
      <view class="topic-name">{{draft.topicSnapshot.title}}</view>
      <view>{{draft.topicSnapshot.summary}}</view>
      <view class="topic-angle" wx:for="{{draft.topicSnapshot.angles}}" wx:key="id">· {{item.title}}</view>
      <navigator class="topic-source" wx:for="{{topicSources}}" wx:key="id" url="{{item.route}}">{{item.title}} ›</navigator>
    </view>
  </view>

  <view class="body-wrap {{draft && draft.topicSnapshot ? 'with-topic' : ''}}" bindtap="focusText">
    <textarea wx:if="{{draft && draft.inputMode === 'text'}}" class="body-input" value="{{body}}" maxlength="-1"
      placeholder="从想说的一句话开始……" cursor-spacing="24" show-confirm-bar="false" adjust-position="false"
      bindinput="onBodyInput" bindkeyboardheightchange="onKeyboardHeight"></textarea>
    <scroll-view wx:elif="{{draft}}" class="body-preview" scroll-y>
      <text wx:if="{{body}}" user-select>{{body}}</text>
      <text wx:else class="placeholder">从想说的一句话开始……</text>
    </scroll-view>
  </view>

  <view class="editor-toolbar" style="bottom: {{keyboardHeight}}px">
    <button class="mode" bindtap="toggleInputMode" aria-label="{{draft && draft.inputMode === 'text' ? '切换到语音输入' : '切换到文字输入'}}">
      <view class="mode-icon">{{draft && draft.inputMode === 'text' ? '声' : '字'}}</view>
    </button>
    <view class="toolbar-line"></view>
    <button class="xiaowen" bindtap="openXiaoWen"><view class="leaf">◇</view><text>小文</text></button>
  </view>

  <view wx:if="{{draft && draft.inputMode === 'voice'}}" class="voice-stage" style="bottom: {{keyboardHeight + 136}}px">
    <view class="voice-copy">{{body ? '正文已保留，长按麦克风继续说。' : '不着急，慢慢说。'}}</view>
    <button class="mic" bindlongpress="voiceUnavailable" aria-label="长按录音">麦</button>
    <view class="voice-help">长按说话；当前服务未配置时可切换文字输入</view>
  </view>

  <view wx:if="{{titleDialog}}" class="dialog-mask" catchtouchmove="noop">
    <view class="title-dialog" role="dialog" aria-modal="true" aria-label="编辑文章标题">
      <view class="dialog-title">文章标题</view>
      <input class="title-input" value="{{titleInput}}" maxlength="120" focus select-text-on-focus placeholder="输入标题"
        bindinput="onTitleInput" confirm-type="done" bindconfirm="confirmTitle" />
      <view class="dialog-actions"><button bindtap="cancelTitle">取消</button><button class="confirm" bindtap="confirmTitle">确定</button></view>
    </view>
  </view>

  <view wx:if="{{xiaowenOpen}}" class="xiaowen-mask" catchtouchmove="noop">
    <view class="xiaowen-panel" role="dialog" aria-modal="true" aria-label="小文文章会话">
      <view class="xiaowen-header">
        <button wx:if="{{xiaowenView !== 'chat'}}" class="xiaowen-back" bindtap="backToConversation" aria-label="返回小文对话">‹</button>
        <view class="xiaowen-title"><text>{{xiaowenView === 'preview' ? candidateTitle : xiaowenView === 'history' ? '修改记录' : '小文'}}</text><small>{{xiaowenView === 'chat' ? '文章伙伴' : '所有内容保存在本机'}}</small></view>
        <view class="xiaowen-header-actions">
          <button wx:if="{{xiaowenView === 'chat'}}" bindtap="showHistory" aria-label="查看修改记录">记录</button>
          <button bindtap="closeXiaoWen">收起小文</button>
        </view>
      </view>

      <scroll-view wx:if="{{xiaowenView === 'chat'}}" class="xiaowen-messages" scroll-y scroll-into-view="xiaowen-end">
        <view class="assistant-message"><view class="assistant-avatar">文</view><view>我可以听你说说想怎么调整文章。只有在你发送后才会请求在线服务；完整候选也要由你确认后才会进入正文。</view></view>
        <view class="xiaowen-turn" wx:for="{{xiaowenTurns}}" wx:key="id">
          <view class="xiaowen-user-message">{{item.prompt}}</view>
          <view class="xiaowen-answer-row">
            <view class="assistant-avatar">文</view>
            <view class="xiaowen-answer">
              <view class="xiaowen-answer-label">{{item.hasCandidate ? '小文的修改说明' : '小文的回答'}}</view>
              <view>{{item.answer}}</view>
              <view class="xiaowen-turn-actions" wx:if="{{item.hasCandidate || item.canRetry || item.canUndo}}">
                <button wx:if="{{item.hasCandidate}}" data-id="{{item.id}}" bindtap="showCandidate">查看{{item.editLabel}}结果</button>
                <button wx:if="{{item.canRetry}}" data-id="{{item.id}}" bindtap="retryTurn">重新发送</button>
                <button wx:if="{{item.canUndo}}" data-id="{{item.id}}" bindtap="undoTurn">撤销{{item.editLabel}}</button>
              </view>
              <view class="xiaowen-turn-status">{{item.status}}</view>
            </view>
          </view>
        </view>
        <view id="xiaowen-end"></view>
        <view wx:if="{{xiaowenStatus === 'blocked'}}" class="xiaowen-request-state">未发送</view>
        <view wx:if="{{xiaowenError}}" class="xiaowen-error">{{xiaowenError}}</view>
        <view wx:if="{{xiaowenRunning}}" class="xiaowen-progress"><text>小文正在处理…</text><button bindtap="cancelXiaoWen">取消请求</button></view>
      </scroll-view>

      <scroll-view wx:elif="{{xiaowenView === 'preview'}}" class="xiaowen-preview" scroll-y>
        <view class="candidate-meta"><text>{{candidateStatus === 'ready' ? '待应用' : candidateStatus === 'applied' ? '已应用' : '仅供查看'}}</text>
          <button bindtap="toggleCandidateOriginal">{{candidateShowOriginal ? '查看候选全文' : '对照原文'}}</button></view>
        <view class="candidate-summary"><strong>小文的{{candidateEditLabel}}说明</strong><text>{{candidateSummary}}</text></view>
        <view class="candidate-full-text" user-select>{{candidateShowOriginal ? candidateOriginalBody : candidateBody}}</view>
        <view class="candidate-note">请核对人物、时间、动作和经历；确认前正文保持不变。</view>
        <view wx:if="{{candidateStale}}" class="xiaowen-error">正文已发生变化。旧结果仅供查看，请根据最新正文重新整理。</view>
        <view wx:if="{{xiaowenError}}" class="xiaowen-error">{{xiaowenError}}</view>
      </scroll-view>

      <scroll-view wx:else class="xiaowen-history" scroll-y>
        <view class="candidate-note">每次手动编辑、应用和恢复都会留下记录。</view>
        <view wx:if="{{xiaowenVersions.length === 0}}" class="history-empty">暂无修改记录</view>
        <view class="history-item" wx:for="{{xiaowenVersions}}" wx:key="id">
          <view><strong>{{item.label}}</strong><text>{{item.title}}</text></view><small>{{item.length}} 字 · {{item.createdAt}}</small>
        </view>
      </scroll-view>

      <view wx:if="{{xiaowenView === 'chat'}}" class="xiaowen-composer">
        <textarea value="{{xiaowenComposer}}" maxlength="2000" auto-height placeholder="问小文，或提要求" disabled="{{operationBusy}}" bindinput="onXiaoWenInput"></textarea>
        <view class="xiaowen-button-cell"><button class="xiaowen-voice" bindtap="voiceUnavailable" disabled="{{operationBusy}}" aria-label="语音输入">声</button></view>
        <view class="xiaowen-button-cell"><button class="xiaowen-send" bindtap="sendXiaoWen" disabled="{{operationBusy || !xiaowenComposer}}">{{operationBusy ? '处理中' : '发送'}}</button></view>
      </view>
      <view wx:elif="{{xiaowenView === 'preview' && candidateStatus === 'ready'}}" class="candidate-actions">
        <button bindtap="dismissCandidate" disabled="{{operationBusy}}">先不修改</button>
        <button class="candidate-apply" bindtap="applyCandidate" disabled="{{operationBusy || candidateStale}}">应用{{candidateEditLabel}}</button>
      </view>
    </view>
  </view>
</view>
