.reader-page { padding:24px 24px calc(32px + env(safe-area-inset-bottom)); }.reading-cover { display:block; width:100%; height:auto; aspect-ratio:5/4; border-radius:16px; }.reading-title { font-family:"Songti SC",serif; font-size:28px; line-height:40px; margin:24px 0 16px; overflow-wrap:anywhere; }.reading-author { display:flex; align-items:center; gap:8px; flex-wrap:wrap; color:#717974; font-size:16px; }.reading-author image { width:32px; height:32px; padding:6px; border-radius:50%; background:#e8eee9; }.reading-author text { overflow-wrap:anywhere; }.reading-date { font-size:14px; }.ai-label { margin-top:14px; font-size:14px; color:#717974; }.reading-body { display:block; white-space:pre-wrap; overflow-wrap:anywhere; font-size:18px; line-height:32px; margin-top:28px; }.share-button { margin-top:40px; min-height:56px; }.reader-status { padding:48px 0; color:#717974; text-align:center; }.reader-error { padding:48px 0; font-size:18px; line-height:30px; text-align:center; }.reader-error button { margin-top:24px; min-height:56px; }
