@import "../../social/shared.wxss";
.reader-page { padding: 20px var(--page-gutter) calc(32px + env(safe-area-inset-bottom)); }
.reader-page.with-share { padding-bottom: calc(116px + env(safe-area-inset-bottom)); }
.reader-share-dock { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 12px var(--page-gutter) calc(16px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--paper); }
.reading-cover { display: block; width: 100%; border-radius: 16px; background: var(--surface); }
.reading-title { margin: 24px 0 20px; color: var(--forest); font: 600 28px/40px "Songti SC", serif; overflow-wrap: anywhere; }
.reading-author { display: flex; align-items: center; gap: 12px; min-width: 0; color: var(--muted); }
.reading-author > image { width: 40px; height: 40px; flex: 0 0 40px; padding: 8px; border-radius: 50%; background: var(--tint); }
.reading-author > view { min-width: 0; }
.reading-name { display: block; font-size: 16px; line-height: 26px; overflow-wrap: anywhere; }
.reading-date { display: block; font-size: 14px; line-height: 22px; }
.ai-label { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 14px; line-height: 22px; color: var(--muted); }
.reading-body { display: block; margin-top: 32px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 18px; line-height: 32px; }
.reading-end { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 40px 0 28px; }
.reading-end > view { width: 40px; height: 1px; background: var(--line); }
.reading-end image { width: 20px; height: 20px; opacity: .55; }
.reader-status { padding: 48px 0; color: var(--muted); font-size: 16px; line-height: 26px; text-align: center; }
.reader-error { padding: 56px 0; color: var(--forest); font-size: 18px; line-height: 30px; text-align: center; }
.reader-error > image { width: 48px; height: 48px; opacity: .6; margin-bottom: 24px; }
.reader-error-actions { margin-top: 32px; }
.reader-error-actions > .text-action { margin-top: 8px; }
.author-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 12px; }


.author-link { width: 0; margin: 0; justify-content: flex-start; flex: 1; display: flex; align-items: center; gap: 12px; padding: 0; text-align: left; }
.author-link > image { width: 40px; height: 40px; flex: 0 0 40px; padding: 8px; border-radius: 50%; background: var(--tint); }
.author-link > view { flex: 1; min-width: 0; }
.social-dock { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 4px; padding: 8px 16px calc(8px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--paper); }
.dock-comment { width: 0; margin: 0; flex: 1; min-width: 0; min-height: 48px; padding: 10px 14px; text-align: left; background: var(--surface); color: var(--muted); font-size: 14px; white-space: nowrap; }
.dock-action { width: 58px; margin: 0; flex: 0 0 58px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 56px; padding: 4px; color: var(--forest); font-size: 12px; line-height: 20px; border-radius: 12px; }
.dock-action image { width: 22px; height: 22px; }
.dock-action.selected { background: var(--tint); }
.flower-summary { display: flex; justify-content: center; align-items: center; gap: 10px; font-size: 16px; color: var(--muted); }
.flower-summary image { width: 26px; height: 32px; }
.comment-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 28px; color: var(--forest); font: 600 23px/34px var(--font-article); }
.comment-row { padding: 12px 0 8px; border-bottom: 1px solid var(--line); }
.comment-person { width: 100%; margin: 0; justify-content: flex-start; display: flex; align-items: center; gap: 10px; padding: 0; color: var(--forest); font-size: 16px; text-align: left; }
.comment-person image { flex: 0 0 30px; width: 30px; height: 30px; border-radius: 50%; padding: 6px; background: var(--tint); }
.comment-body { display: block; white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 8px; font-size: 17px; line-height: 29px; }
.comment-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 13px; line-height: 22px; }
.comment-meta > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.comment-meta image { opacity: .65; }
.comment-input { width: 100%; height: 62px; padding: 10px 12px; border-radius: 12px; background: var(--surface); font-size: 16px; line-height: 26px; }
.comment-compose-bottom { display: flex; align-items: center; gap: 12px; justify-content: space-between; margin-top: 8px; color: var(--muted); font-size: 13px; }
.comment-compose-bottom > button.primary-action { margin: 0; width: auto; min-height: 48px; padding: 10px 20px; font-size: 16px; line-height: 26px; }
.reader-page button.all-comments { display: flex; width: auto; margin: 12px auto 24px; }
@media (max-width: 370px) { .social-dock { padding-left: 12px; padding-right: 12px; }.dock-action { flex-basis: 54px; }.dock-comment { padding-left: 10px; }.follow-button { min-width: 82px; padding-left: 10px; padding-right: 10px; } }

.compact-keyboard .comment-input { height: 48px; }.compact-keyboard .social-sheet-head { flex-basis: 48px; }.compact-keyboard.social-sheet { padding-top: 4px; padding-bottom: 8px; }.compact-keyboard .social-sheet-bottom { padding-top: 6px; }

.compact-keyboard .social-sheet-bottom .error-panel, .compact-keyboard .social-sheet-bottom .notice { max-height: 40px; padding: 4px 8px; line-height: 20px; }

.reading-author > button.author-link { width: 0; margin: 0; padding: 0; justify-content: flex-start; }
.social-dock > button.dock-comment { width: 0; margin: 0; }
.social-dock > button.dock-action { width: 58px; margin: 0; }
.social-sheet button.comment-person, .reader-page button.comment-person { width: 100%; margin: 0; padding: 0; justify-content: flex-start; }
.social-sheet .comment-compose-bottom > button.primary-action { width: auto; margin: 0; }
