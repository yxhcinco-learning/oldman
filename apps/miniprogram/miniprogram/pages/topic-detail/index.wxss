.detail-page { padding-top: 36rpx; }
.topic-state { padding: 48rpx 0; color: #717974; font-size: 30rpx; }
.topic-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16rpx; color: #717974; font-size: 25rpx; line-height: 44rpx; }
.topic-meta text:first-child { min-height: 48rpx; padding: 2rpx 18rpx; border-radius: 24rpx; background: #e8eee9; color: #416657; }
.detail-title { margin-top: 32rpx; }
.correction { margin-top: 32rpx; padding: 28rpx; border-radius: 26rpx; background: #e8eee9; color: #416657; font-size: 28rpx; line-height: 1.65; }
.correction view { color: #153b2e; font-weight: 600; }
.section { margin-top: 52rpx; }
.section-title { margin-bottom: 20rpx; color: #153b2e; font-family: "Songti SC", serif; font-size: 36rpx; font-weight: 600; }
.section-copy { color: #1b1c1c; font-size: 34rpx; line-height: 1.8; }
.angle { display: grid; min-height: 96rpx; grid-template-columns: 20rpx 1fr; align-items: center; gap: 18rpx; margin-top: 14rpx; padding: 20rpx 28rpx; border-radius: 26rpx; background: #fff; color: #416657; font-size: 30rpx; line-height: 1.65; }
.angle-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #416657; }
.source { display: flex; min-height: 112rpx; margin-top: 14rpx; padding: 20rpx 28rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-radius: 26rpx; background: #fff; color: #153b2e; font-size: 29rpx; line-height: 1.5; }
.source small { display: block; color: #717974; font-size: 25rpx; }
.source b { color: #416657; font-size: 44rpx; font-weight: 400; }
.start-actions { position: sticky; bottom: calc(-1 * env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 56rpx -8rpx 0; padding: 24rpx 8rpx calc(28rpx + env(safe-area-inset-bottom)); background: linear-gradient(rgba(251, 249, 248, 0), #fbf9f8 24rpx); }
.start-actions button { padding-right: 16rpx; padding-left: 16rpx; font-size: 29rpx; }
