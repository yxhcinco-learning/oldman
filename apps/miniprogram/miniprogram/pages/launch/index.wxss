.launch-page { display: flex; min-height: 100vh; flex-direction: column; align-items: center; justify-content: center; padding: 48px 24px; background: #fbf9f8; }
.launch-brand { margin: auto 0; text-align: center; }
.launch-brand image { width: 52px; height: 52px; margin-bottom: 24px; }
.launch-brand view { color: #153b2e; font: 32px/46px "Songti SC", SimSun, serif; letter-spacing: .16em; }
.launch-brand text { display: block; margin-top: 16px; color: #717974; font-size: 16px; line-height: 26px; }
.launch-signature { color: #416657; font-size: 14px; line-height: 22px; letter-spacing: .12em; padding-bottom: env(safe-area-inset-bottom); }
