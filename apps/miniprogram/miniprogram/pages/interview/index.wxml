<view class="interview-page" style="padding-bottom: {{keyboardHeight}}px">
  <view class="interview-header" style="height: {{navigationHeight}}px;">
    <view class="interview-nav-row" style="top: {{navigationRowTop}}px; height: 48px; padding-right: {{menuReserve}}px;">
      <view class="interview-back" bindtap="closeInterview" role="button" aria-label="返回"><view class="back-chevron"></view></view>
      <view class="interview-title">小文</view>
    </view>
  </view>
  <view class="interview-context"><view class="conversation-topic">
    <view wx:if="{{draft && draft.topicSnapshot}}" class="topic-heading"><image src="/assets/book.svg" /><view class="topic-window"><text class="topic-text {{topicDistance > 1 ? 'topic-moving' : ''}}" style="--topic-distance: -{{topicDistance || 0}}px; --topic-duration: {{topicDuration || 7}}s">{{draft.topicSnapshot.title}}</text></view></view>
    <view class="ai-mode-bar"><text class="topic-state">{{mode === 'interview' ? '访谈中' : '和小文聊聊'}}</text><button bindtap="composeArticle" disabled="{{saving || voiceBusy}}">结束访谈并整理</button></view></view>
  </view>
  <scroll-view class="messages" scroll-y scroll-into-view="interview-end-{{messages.length}}-{{saving ? 1 : 0}}-{{pendingEdit ? 1 : 0}}" aria-label="小文访谈对话">
    <view class="message {{item.role}}" wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.role === 'assistant'}}" class="avatar"><image src="/assets/leaf.svg" mode="aspectFit"></image></view><view class="{{item.role === 'system' ? 'conversation-event' : 'bubble'}}"><view wx:if="{{!item.pending}}">{{item.text}}</view>
        <view wx:if="{{item.pending}}" class="reply-pending" role="status" aria-label="{{item.text}}"><view /><view class="reply-dot-second" /><view class="reply-dot-third" /></view>
        <button wx:if="{{item.role === 'assistant' && index === messages.length - 1 && !item.pending && !item.canRetry && hasAnswers && !pendingEdit}}" class="change-question" bindtap="changeQuestion" disabled="{{saving || voiceBusy}}">换个问题</button>
        <view wx:if="{{item.error}}">{{item.error}}</view><button wx:if="{{item.canRetry}}" data-id="{{item.turnId}}" bindtap="retryTurn" disabled="{{saving}}">重新发送</button></view>
    </view>
    <view wx:if="{{pendingEdit}}"><button bindtap="confirmEdit" disabled="{{saving}}">结束访谈并继续修改</button><button bindtap="continueInterview" disabled="{{saving}}">继续访谈</button></view>
    <view id="interview-end-{{messages.length}}-{{saving ? 1 : 0}}-{{pendingEdit ? 1 : 0}}"></view>
  </scroll-view>
  <view class="interview-footer">

    <view wx:if="{{error && !messages[messages.length - 1].error}}" class="interview-error" role="alert">{{error}}</view>
    <view wx:if="{{voicePressing || voicePhase !== 'idle'}}" class="interview-error">{{voiceText || voiceMessage || (voicePressing ? '已按住，松开结束' : '正在准备语音…')}}</view>
    <view class="composer-row">
      <textarea value="{{composer}}" maxlength="12000" auto-height placeholder="回复小文" placeholder-style="color:#858e88;line-height:30px" disabled="{{saving || voiceBusy}}" disable-default-padding="{{true}}"
        adjust-position="{{false}}" show-confirm-bar="{{false}}" cursor-spacing="20" bindinput="onComposer" bindfocus="onComposerFocus" bindblur="onComposerBlur" bindkeyboardheightchange="onKeyboardHeight"></textarea>
      <view class="composer-button-cell"><button class="voice {{voicePressing ? 'pressing' : ''}} {{saving ? 'is-disabled' : ''}}" bindtouchstart="pressDictation" bindtouchend="releaseDictation" bindtouchcancel="cancelDictation" aria-disabled="{{saving}}" aria-label="长按语音回答" hover-class="none"><image src="/assets/mic.svg" mode="aspectFit"></image></button></view>
      <view class="composer-button-cell"><button wx:if="{{messages[messages.length - 1].pending}}" class="ai-stop" bindtap="cancelRequest" aria-label="停止回复"><view />停止</button><button wx:else class="send {{saving || voiceBusy || !composer ? 'is-disabled' : ''}}" bindtap="sendAnswer" aria-disabled="{{saving || voiceBusy || !composer}}" hover-class="none">{{saving ? '处理中' : '发送'}}</button></view>
    </view>
  </view>
</view>
