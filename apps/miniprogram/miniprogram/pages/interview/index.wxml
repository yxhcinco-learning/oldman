<view class="interview-page" style="padding-bottom: {{keyboardHeight}}px">
  <view class="interview-header" style="height: {{navigationHeight}}px;">
    <view class="interview-nav-row" style="top: {{navigationRowTop}}px; height: 48px; padding-right: {{menuReserve}}px;">
      <view class="interview-back" bindtap="closeInterview" role="button" aria-label="返回"><view class="back-chevron"></view></view>
      <view class="interview-title">小文采访</view>
      <view class="interview-close" bindtap="closeInterview" role="button">收起</view>
    </view>
  </view>
  <scroll-view class="messages" scroll-y scroll-into-view="current-question">
    <view wx:if="{{draft && draft.topicSnapshot}}" class="interview-topic">聊聊：{{draft.topicSnapshot.title}}</view>
    <view class="message {{item.role}}" wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.role === 'assistant'}}" class="avatar">文</view><view class="bubble">{{item.text}}</view>
    </view>
    <view id="current-question" class="message assistant current">
      <view class="avatar">文</view>
      <view><view class="bubble">{{question}}</view><button wx:if="{{draft && draft.materials.length}}" class="change-question" bindtap="changeQuestion">换个问题</button></view>
    </view>
  </scroll-view>
  <view class="interview-footer">
    <button wx:if="{{draft && draft.materials.length}}" class="compose-link" bindtap="composeArticle">整理成文章</button>
    <view wx:if="{{error}}" class="interview-error" role="alert">{{error}}</view>
    <view wx:if="{{voicePressing || voicePhase !== 'idle'}}" class="interview-error">{{voiceText || voiceMessage || (voicePressing ? '已按住，松开结束' : '正在准备语音…')}}</view>
    <view class="composer-row">
      <textarea value="{{composer}}" maxlength="12000" auto-height placeholder="写下回答" disabled="{{saving || voiceBusy}}"
        adjust-position="false" cursor-spacing="20" bindinput="onComposer" bindkeyboardheightchange="onKeyboardHeight"></textarea>
      <view class="composer-button-cell"><button class="voice {{voicePressing ? 'pressing' : ''}}" bindtouchstart="pressDictation" bindtouchend="releaseDictation" bindtouchcancel="cancelDictation" disabled="{{saving}}" aria-label="长按语音回答"><image src="/assets/mic.svg" mode="aspectFit"></image></button></view>
      <view class="composer-button-cell"><button class="send" bindtap="sendAnswer" disabled="{{saving || voiceBusy || !composer}}">{{saving ? '保存中' : '发送'}}</button></view>
    </view>
  </view>
</view>
