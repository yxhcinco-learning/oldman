page { height: 100%; overflow: hidden; }
.interview-page { height: 100vh; background: #fbf9f8; transition: padding-bottom .15s ease; }
.interview-header { display: flex; min-height: 128rpx; padding: 18rpx 32rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #e4e6e1; }
.interview-header text { display: block; color: #153b2e; font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 600; }
.interview-header small { display: block; max-width: 430rpx; overflow: hidden; color: #717974; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.interview-header button { min-height: 96rpx; padding: 12rpx 18rpx; background: transparent; color: #153b2e; font-size: 28rpx; line-height: 72rpx; }
.messages { height: calc(100% - 348rpx); padding: 32rpx 32rpx 80rpx; }
.message { display: flex; margin-bottom: 28rpx; align-items: flex-start; gap: 16rpx; }
.message.user { justify-content: flex-end; }
.avatar { display: grid; width: 64rpx; height: 64rpx; flex: 0 0 64rpx; place-items: center; border-radius: 50%; background: #e6eddf; color: #416657; font-family: "Songti SC", serif; }
.bubble { max-width: 580rpx; padding: 24rpx 28rpx; border-radius: 0 30rpx 30rpx 30rpx; background: #fff; color: #1b1c1c; font-size: 32rpx; line-height: 1.7; }
.message.user .bubble { border-radius: 30rpx 0 30rpx 30rpx; background: #153b2e; color: #f6f8f2; }
.current { padding-bottom: 24rpx; }
.change-question { min-height: 88rpx; margin: 8rpx 0 0; padding: 10rpx 0; background: transparent; color: #416657; font-size: 27rpx; line-height: 68rpx; text-align: left; text-decoration: underline; }
.interview-footer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; min-height: 220rpx; padding: 14rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e4e6e1; background: #fbf9f8; }
.compose-link { min-height: 80rpx; margin: 0 0 4rpx auto; padding: 8rpx 14rpx; background: transparent; color: #416657; font-size: 27rpx; line-height: 64rpx; text-align: right; }
.composer-row { display: grid; grid-template-columns: minmax(0, 1fr) 96rpx 112rpx; align-items: end; gap: 12rpx; }
.composer-row textarea { width: 100%; min-height: 104rpx; max-height: 296rpx; padding: 20rpx 24rpx; border: 1rpx solid #e4e6e1; border-radius: 28rpx; background: #fff; font-size: 32rpx; line-height: 1.6; }
.composer-button-cell { display: flex; min-width: 0; }
.voice, .send { min-height: 96rpx; padding: 12rpx; border-radius: 48rpx; font-size: 28rpx; line-height: 72rpx; }
.voice, .send { min-width: 0; flex: 1; margin: 0; }
.voice { background: #e8eee9; color: #153b2e; }
.send { background: #153b2e; color: #fff; }
.send[disabled], .voice[disabled] { opacity: .45; }
.interview-error { max-height: 100rpx; margin-bottom: 10rpx; overflow-y: auto; color: #6f351c; font-size: 25rpx; line-height: 1.55; }
