.profile-navigation { position: sticky; top: 0; z-index: 30; background: #fbf9f8; }
.profile-heading { padding: 24px 0; }
.account-panel { margin-bottom: 28px; }
.profile-page .account-heading { display: flex; width: 100%; max-width: none; min-width: 0; align-items: center; gap: 16px; padding: 0; color: #153b2e; background: transparent; text-align: left; }
.account-avatar { display: flex; width: 64px; height: 64px; flex: 0 0 64px; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #e8eee9; }
.account-avatar image { width: 64px; height: 64px; }
.account-avatar .default-avatar { width: 30px; height: 30px; }
.account-copy { flex: 1; min-width: 0; }
.account-name { color: #153b2e; font-size: 22px; line-height: 32px; overflow-wrap: anywhere; }
.account-status { margin-top: 4px; color: #717974; font-size: 14px; line-height: 22px; }
.row-chevron { width: 9px; height: 9px; margin: 0 5px; flex-shrink: 0; border-top: 1.5px solid #789083; border-right: 1.5px solid #789083; transform: rotate(45deg); }
.profile-page .account-primary, .backup-sheet .account-primary { display: flex; width: 100%; max-width: none; min-width: 0; min-height: 56px; margin-top: 20px; padding: 12px 16px; align-items: center; justify-content: center; border-radius: 30px; background: #153b2e; color: #fff; font-size: 18px; line-height: 28px; }
.sync-row { display: flex; justify-content: space-between; gap: 12px; align-items: center; min-height: 28px; margin-top: 20px; }
.sync-copy { display: flex; min-width: 0; align-items: center; gap: 8px; }
.sync-row text { color: #717974; font-size: 14px; line-height: 22px; }
.sync-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: #416657; }
.sync-muted { background: #9ba59d; }
.sync-row button { width: auto; max-width: none; min-width: 48px; min-height: 48px; margin: -10px 0; padding: 10px 4px; background: transparent; color: #416657; font-size: 16px; line-height: 26px; }
.account-error { margin-top: 12px; color: #944924; font-size: 14px; line-height: 22px; }
.profile-section-label { margin-bottom: 12px; color: #717974; font-size: 14px; line-height: 22px; }
.tool-list { width: 100%; padding: 0 16px; border-radius: 16px; background: #fff; box-shadow: 0 4px 20px rgba(21, 59, 46, .03); }
.tool-list .tool { display: flex; width: 100%; max-width: none; min-width: 0; min-height: 64px; align-items: center; gap: 16px; padding: 16px 0; border-radius: 0; background: transparent; color: #153b2e; text-align: left; }
.tool-list .tool + .tool { border-top: 1px solid #eff0ec; }
.tool image, .tool-symbol { width: 24px; height: 24px; flex: 0 0 24px; }
.tool-symbol { color: #416657; text-align: center; font-size: 24px; line-height: 24px; }
.tool text { flex: 1; font-size: 18px; line-height: 28px; }
.support-list { margin-top: 16px; }
.profile-page .logout-button { display: flex; width: 100%; max-width: none; min-height: 56px; margin-top: 24px; padding: 14px; justify-content: center; align-items: center; border: 1px solid #e4e6e1; border-radius: 28px; color: #717974; background: transparent; font-size: 16px; line-height: 26px; }
.backup-sheet .avatar-choose { display: flex; width: 100%; max-width: none; min-width: 0; align-items: center; justify-content: center; gap: 16px; min-height: 80px; margin: 0 0 20px; color: #153b2e; background: #e8eee9; border-radius: 16px; font-size: 18px; }
.avatar-choose image { width: 56px; height: 56px; border-radius: 50%; }
.nickname-label { display: block; color: #416657; font-size: 16px; line-height: 28px; }
.nickname-input { height: 56px; margin-top: 8px; padding: 0 16px; border: 1px solid #e4e6e1; border-radius: 12px; background: #fff; font-size: 18px; }
.logout-copy { color: #515e56; font-size: 16px; line-height: 28px; }
.logout-actions { display: flex; gap: 12px; margin-top: 24px; }
.logout-actions button { flex: 1; }
.sheet-mask { position: fixed; z-index: 40; inset: 0; display: flex; align-items: flex-end; background: rgba(28, 50, 41, .23); backdrop-filter: blur(8px); }
.backup-sheet { width: 100%; max-height: 88vh; overflow-y: auto; padding: 12px 24px max(28px, env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; background: #fbf9f8; }
.sheet-handle { width: 36px; height: 4px; margin: 0 auto 24px; border-radius: 5px; background: #c9cbc6; }
.sheet-brand { color: #944924; font-family: "Songti SC", serif; font-size: 13px; line-height: 20px; }
.sheet-heading { display: flex; margin-bottom: 28px; align-items: center; justify-content: space-between; gap: 12px; }
.sheet-heading view { min-width: 0; color: #153b2e; font-family: "Songti SC", serif; font-size: 22px; font-weight: 600; line-height: 32px; }
.sheet-heading button { display: grid; width: 48px; min-width: 48px; height: 48px; margin: 0; padding: 0; place-items: center; border: 0; border-radius: 50%; background: #efeee9; color: #416657; font-size: 28px; font-weight: 300; line-height: 1; }
.sheet-tools { display: grid; gap: 12px; }
.sheet-tools > button { display: grid; width: 100%; max-width: none; min-width: 0; min-height: 84px; margin: 0; grid-template-columns: 24px minmax(0, 1fr) 18px; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 16px; background: #fff; color: #153b2e; text-align: left; }
.sheet-icon { display: grid; width: 24px; height: 24px; place-items: center; color: #416657; font-size: 19px; line-height: 24px; }
.sheet-book { width: 24px; height: 24px; opacity: .78; }
.sheet-tools text { display: block; font-family: "Songti SC", serif; font-size: 18px; line-height: 26px; }
.sheet-tools small { display: block; color: #717974; font-size: 14px; line-height: 21px; }
.sheet-tools b { color: #416657; font-size: 22px; font-weight: 400; }
.sheet-note { display: grid; gap: 8px; margin-top: 16px; color: #717974; font-size: 13px; line-height: 22px; }

@media (max-width: 370px) {
  .backup-sheet { padding-right: 20px; padding-left: 20px; }
  .sheet-tools > button { padding-right: 14px; padding-left: 14px; }
}
