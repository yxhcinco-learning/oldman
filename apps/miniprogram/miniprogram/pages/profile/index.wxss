.profile-page { padding-top: 36rpx; }
.profile-eyebrow { margin-top: 54rpx; }
.tool-list { display: flex; width: 100%; flex-direction: column; gap: 20rpx; margin-top: 48rpx; }
.tool-row { display: flex; width: 100%; }
.tool { display: grid; width: 100%; max-width: none; min-height: 176rpx; flex: 1; margin: 0; grid-template-columns: 104rpx minmax(0, 1fr) 40rpx; align-items: center; gap: 24rpx; padding: 30rpx; border: 1rpx solid #e4e6e1; border-radius: 32rpx; background: #fff; color: #153b2e; text-align: left; }
.tool-icon { display: grid; width: 104rpx; height: 104rpx; place-items: center; border-radius: 50%; background: #e8eee9; font-family: "Songti SC", serif; font-size: 34rpx; }
.tool text { display: block; font-family: "Songti SC", serif; font-size: 36rpx; font-weight: 600; line-height: 1.45; }
.tool small { display: block; margin-top: 4rpx; color: #717974; font-size: 26rpx; line-height: 1.55; }
.tool b { color: #416657; font-size: 48rpx; font-weight: 400; }
.tool[disabled] { opacity: .55; }
.storage-note { display: grid; gap: 16rpx; margin-top: 44rpx; padding: 32rpx; border-radius: 28rpx; background: #e8eee9; color: #416657; font-size: 28rpx; line-height: 1.7; }
.note-title { color: #153b2e; font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 600; }
