.profile-navigation { position: sticky; top: 0; z-index: 30; background: var(--paper); }
.profile-page { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
.account-panel { padding: 14px 0 8px; }
.profile-identity { display: flex; align-items: center; gap: 12px; }
button.account-heading { display: flex; width: 0; max-width: none; min-width: 0; flex: 1; align-items: center; gap: 14px; margin: 0; padding: 0; background: transparent; text-align: left; }
.account-avatar { display: flex; width: 58px; height: 58px; flex: 0 0 58px; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: var(--tint); }
.account-avatar image { width: 58px; height: 58px; }
.account-avatar .default-avatar { width: 29px; height: 29px; }
.account-copy { flex: 1; min-width: 0; }
.account-name { color: var(--forest); font: 600 25px/36px "Songti SC", serif; overflow-wrap: anywhere; }
.account-status { margin-top: 4px; color: var(--muted); font-size: 14px; line-height: 22px; }
button.settings-entry { display: grid; width: 48px; height: 48px; flex: 0 0 48px; margin: 0 -8px 0 0; padding: 0; place-items: center; background: transparent; }
.settings-symbol { display: grid; width: 23px; height: 23px; place-items: center; border: 1.5px solid var(--forest-soft); border-radius: 7px; transform: rotate(30deg); }
.settings-symbol view { width: 8px; height: 8px; border: 1.5px solid var(--forest-soft); border-radius: 50%; }
.row-chevron { width: 8px; height: 8px; flex: 0 0 8px; margin: 0 4px; border-right: 1.5px solid #879784; border-top: 1.5px solid #879784; transform: rotate(45deg); }
button.account-primary { display: flex; width: 100%; min-width: 0; min-height: 56px; margin: 20px 0 0; padding: 12px 16px; align-items: center; justify-content: center; border-radius: 28px; background: var(--forest); color: white; font-size: 18px; line-height: 28px; }
.sync-row { display: flex; align-items: center; gap: 12px; margin: 16px 0 0; }
.account-error { flex: 1; min-width: 0; color: var(--sienna); font-size: 14px; line-height: 22px; }
.sync-row button { flex: 0 0 auto; min-height: 48px; padding: 8px 0; }
.settings-page, .data-page { min-height: calc(100vh - 100px); padding-top: 8px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.settings-caption { margin: 24px 0 10px; color: var(--muted); font-size: 13px; line-height: 22px; }
button.setting-row { display: flex; width: 100%; min-width: 0; min-height: 66px; gap: 12px; margin: 0; padding: 12px 0; align-items: center; text-align: left; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; }
.setting-row > image { width: 22px; height: 22px; flex: 0 0 22px; }
.setting-row > text { flex: 1; min-width: 0; font-size: 18px; line-height: 28px; color: var(--ink); }
.settings-logout.text-action { display: flex; width: 100%; margin-top: 32px; color: var(--sienna); }
.data-intro { margin: 18px 0 26px; color: var(--muted); font-size: 16px; line-height: 28px; }
.data-row > view:not(.row-chevron) { flex: 1; min-width: 0; }
.data-row text { display: block; color: var(--ink); font-size: 18px; line-height: 28px; }
.data-row small { display: block; margin-top: 5px; color: var(--muted); font-size: 14px; line-height: 24px; }
.data-row { min-height: 94px; }
.data-status { margin-top: 24px; color: var(--muted); font-size: 14px; line-height: 22px; }
.data-note { margin-top: 12px; color: var(--muted); font-size: 14px; line-height: 24px; }
.sheet-mask { position: fixed; z-index: 40; inset: 0; max-height: 100vh; display: flex; align-items: flex-end; background: rgba(28,50,41,.23); backdrop-filter: blur(8px); }
.profile-sheet { width: 100%; max-height: 100%; overflow-y: auto; padding: 12px 24px max(28px,env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; background: var(--paper); }
.sheet-handle { width: 36px; height: 4px; margin: 0 auto 24px; border-radius: 5px; background: #c9cbc6; }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
.sheet-heading > view { color: var(--forest); font: 600 22px/32px "Songti SC", serif; }
.sheet-heading button { display: grid; width: 48px; height: 48px; flex: 0 0 48px; margin: 0; padding: 0; place-items: center; border-radius: 50%; background: #efeee9; }
.sheet-heading button image { width: 22px; height: 22px; }
button.avatar-choose { display: flex; width: 100%; min-width: 0; min-height: 84px; gap: 16px; margin: 0 0 16px; padding: 12px 0; align-items: center; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; text-align: left; }
.avatar-choose image { width: 56px; height: 56px; flex: 0 0 56px; border-radius: 50%; }
.avatar-choose .default-choice { padding: 14px; background: var(--tint); }
.avatar-choose text { flex: 1; font-size: 18px; line-height: 28px; }
.compact-profile .sheet-handle { display: none; }
.compact-profile .sheet-heading { margin-bottom: 8px; }
.compact-profile .profile-sheet { padding-top: 12px; padding-bottom: 16px; }
.logout-copy { color: var(--muted); font-size: 16px; line-height: 28px; }
.logout-actions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin-top: 24px; }
@media(max-width:370px) { .profile-sheet { padding-left: 20px; padding-right: 20px; } .account-name { font-size: 23px; } .profile-identity { gap: 8px; } button.account-heading { gap: 12px; } }
