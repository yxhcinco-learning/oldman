.profile-page { padding-top: 28rpx; }
.profile-eyebrow { margin-top: 34rpx; }
.tool-list { display: flex; width: 100%; flex-direction: column; gap: 16rpx; margin-top: 32rpx; }
.tool-row { display: flex; width: 100%; }
.tool { display: grid; width: 100%; max-width: none; min-height: 152rpx; flex: 1; margin: 0; grid-template-columns: 88rpx minmax(0, 1fr) 32rpx; align-items: center; gap: 20rpx; padding: 24rpx; border: 1rpx solid #e4e6e1; border-radius: 28rpx; background: #fff; color: #153b2e; text-align: left; }
.tool-icon { display: grid; width: 88rpx; height: 88rpx; place-items: center; border-radius: 50%; background: #e8eee9; font-family: "Songti SC", serif; font-size: 31rpx; }
.tool text { display: block; font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 600; line-height: 1.42; }
.tool small { display: block; margin-top: 4rpx; color: #717974; font-size: 26rpx; line-height: 1.55; }
.tool b { color: #416657; font-size: 48rpx; font-weight: 400; }
.tool[disabled] { opacity: .55; }
.storage-note { display: grid; gap: 14rpx; margin-top: 32rpx; padding: 26rpx; border-radius: 24rpx; background: #e8eee9; color: #416657; font-size: 26rpx; line-height: 1.62; }
.note-title { color: #153b2e; font-family: "Songti SC", serif; font-size: 31rpx; font-weight: 600; }
.privacy-note { margin-bottom: 180rpx; }
