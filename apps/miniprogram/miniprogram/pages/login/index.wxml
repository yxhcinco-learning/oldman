<view class="login-page">
  <app-brand />
  <view class="login-story">
    <image class="login-illustration" src="/assets/letter.svg" mode="aspectFit" />
    <view class="login-title">把想说的话，<view>慢慢写下来<text>。</text></view></view>
    <view class="login-description">生活里的小事，心里惦记的人。<view>每一句，都值得留下。</view></view>
  </view>
  <view class="login-actions">
    <view wx:if="{{reason}}" class="login-reason">{{reason}}</view>
    <view wx:if="{{error}}" class="error-panel" role="alert">{{error}}</view>
    <button class="login-primary" bindtap="login" disabled="{{busy}}" loading="{{busy}}">{{busy ? (signedIn ? '正在同步' : '正在登录') : signedIn ? '重试同步并继续' : '微信授权登录'}}</button>
    <view class="login-saving">登录后自动保存作品，换台设备接着写</view>
    <button class="login-skip" bindtap="skip" disabled="{{busy}}">{{contextual ? '暂不登录，返回' : '先看看'}}</button>
    <view class="login-terms"><text>首次登录自动创建账号</text><button bindtap="openPrivacy">隐私说明<text> ›</text></button></view>
  </view>
</view>
