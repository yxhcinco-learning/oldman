.login-page { display: flex; min-height: 100vh; padding: 0 24px max(20px, env(safe-area-inset-bottom)); flex-direction: column; }
.login-story { display: flex; flex: 1; flex-direction: column; justify-content: center; align-items: center; padding: 28px 0 32px; text-align: center; }
.login-illustration { width: 180px; height: 153px; margin-bottom: 24px; }
.login-title { color: #153b2e; font: 28px/42px "Noto Serif SC", "Songti SC", SimSun, serif; letter-spacing: .06em; }
.login-title text { color: #944924; }
.login-description { margin-top: 16px; color: #717974; font-size: 16px; line-height: 28px; }
.login-actions { flex-shrink: 0; width: 100%; max-width: 420px; margin: 0 auto; }
.login-actions .login-primary { display: flex; width: 100%; max-width: none; min-width: 0; min-height: 56px; align-items: center; justify-content: center; padding: 14px 20px; border-radius: 30px; background: #153b2e; color: #fff; font-size: 18px; line-height: 28px; }
.login-actions .login-primary[disabled] { background: #416657; color: #fff; }
.login-terms { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0 12px; margin-top: 12px; color: #717974; font-size: 14px; line-height: 22px; }
.login-terms button { width: auto; max-width: none; min-width: 0; min-height: 48px; margin: 0; padding: 12px 0; color: #416657; background: transparent; font-size: 14px; line-height: 22px; }
.login-reason { margin-bottom: 16px; color: #416657; font-size: 16px; line-height: 26px; }
.login-actions .error-panel { margin: 0 0 16px; }
@media (max-height: 700px) { .login-story { padding: 16px 0 24px; } .login-illustration { width: 124px; height: 105px; margin-bottom: 16px; } .login-title { font-size: 26px; line-height: 38px; } .login-description { margin-top: 12px; } .login-terms { margin-top: 0; } }
@media (max-width: 370px) { .login-page { padding-right: 20px; padding-left: 20px; } }
