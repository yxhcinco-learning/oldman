<block wx:if="{{accountReady}}"><page-header title="我的关注" />
<view class="social-page">
  <view class="relationship-tabs" role="tablist"><button class="{{tab === 'following' ? 'active' : ''}}" data-tab="following" bindtap="switchTab" role="tab" aria-selected="{{tab === 'following'}}">关注</button><button class="{{tab === 'followers' ? 'active' : ''}}" data-tab="followers" bindtap="switchTab" role="tab" aria-selected="{{tab === 'followers'}}">粉丝</button><button class="{{tab === 'mutuals' ? 'active' : ''}}" data-tab="mutuals" bindtap="switchTab" role="tab" aria-selected="{{tab === 'mutuals'}}">互关</button></view>
  <view wx:if="{{error}}" class="error-panel" role="alert">{{error}}<button wx:if="{{needsLogin}}" class="text-action" bindtap="login">微信登录</button><button wx:else class="text-action" bindtap="refresh">重新读取</button></view>
  <view wx:if="{{loading}}" class="social-empty-compact">正在读取…</view>
  <view wx:for="{{authors}}" wx:key="id" class="relationship-row"><button class="relationship-person" data-id="{{item.id}}" bindtap="openAuthor"><image src="/assets/leaf.svg" /><view><text>{{item.name}}</text><text class="social-muted">{{item.articles}} 篇文章</text></view></button><button class="follow-button {{item.relationship.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="follow" disabled="{{busy}}">{{item.relationship.mutual ? '互相关注' : item.relationship.active ? '已关注' : item.relationship.followedBy ? '回关' : '+ 关注'}}</button></view>
  <view wx:if="{{!loading && !error && !authors.length}}" class="social-empty"><image src="/assets/social-people.svg" /><view class="social-empty-title">{{tab === 'following' ? '还没有关注作者' : tab === 'followers' ? '还没有粉丝' : '还没有互相关注的作者'}}</view><view class="social-empty-copy">{{tab === 'following' ? '读到喜欢的文章，可以关注作者。' : tab === 'followers' ? '分享您的文章，让更多人读到。' : '您关注的作者也关注您时，会出现在这里。'}}</view><button class="secondary-action" bindtap="readArticles">去读一篇文章</button></view>
  <button wx:if="{{cursor}}" class="text-action" bindtap="more" disabled="{{moreLoading}}">{{moreLoading ? '正在读取…' : '继续查看'}}</button><view wx:elif="{{authors.length}}" class="list-end">已读完</view>
</view></block>
