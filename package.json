{
  "name": "suiyue-yousheng",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vinext dev --port 3001",
    "dev:speech": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec:check": "openspec validate --all --strict",
    "check": "npm run typecheck && npm run lint && npm test && npm run spec:check && npm run security:check",
    "security:check": "node scripts/check-boundaries.mjs",
    "test:speech:live": "node --env-file-if-exists=.env.local scripts/speech-live-check.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.1",
    "idb": "8.0.3",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@fission-ai/openspec": "1.2.0",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "28.1.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
