{
  "name": "suiyue-yousheng",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/miniprogram",
    "packages/core"
  ],
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:core && npm run build:admin && npm run build:miniprogram",
    "build:core": "npm run build --workspace @suiyue/core",
    "build:miniprogram": "npm run build --workspace @suiyue/miniprogram",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern coverage --ignore-pattern packages/core/dist --ignore-pattern apps/miniprogram/miniprogram/miniprogram_npm",
    "typecheck": "npm run typecheck:server-admin && npm run typecheck --workspace @suiyue/core && npm run typecheck --workspace @suiyue/miniprogram",
    "test": "npm run test:server-admin && npm run test --workspace @suiyue/core && npm run test --workspace @suiyue/miniprogram",
    "test:watch": "vitest",
    "spec:check": "openspec validate --all --strict",
    "check": "npm run typecheck && npm run lint && npm test && npm run spec:check && npm run docs:check && npm run security:check",
    "docs:check": "node scripts/check-docs.mjs",
    "security:check": "node scripts/check-boundaries.mjs",
    "test:speech:live": "node --env-file-if-exists=.env.local scripts/speech-live-check.mjs",
    "test:topic-ai:live": "node --env-file-if-exists=.env.local --import tsx scripts/topic-ai-live-check.mjs",
    "admin:hash-password": "node --import tsx scripts/hash-topic-admin-password.mjs",
    "dev:admin": "vinext dev --port 3001",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build:admin": "vinext build",
    "typecheck:server-admin": "tsc --noEmit",
    "test:server-admin": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.1.0",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "type": "module"
}
