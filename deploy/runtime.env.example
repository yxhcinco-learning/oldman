# Install as /etc/suiyue-yousheng/runtime.env with mode 0600 root:root.
# Never commit the populated file or include it in a release archive.
NODE_ENV=production
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3012
ASR_ALLOWED_ORIGIN=https://suiyue.maicong.chat
ASR_CREDENTIAL_SOURCE=project
TENCENT_ASR_APP_ID=1439188935
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_TOKEN=
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
ASR_MAX_CONNECTIONS=2
ALLOW_PAID_SPEECH_TEST=0
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
SUIYUE_AUTH_DB_PATH=/var/lib/suiyue-yousheng/auth.sqlite
SUIYUE_TOPICS_DB_PATH=/var/lib/suiyue-yousheng/topics.sqlite
TOPIC_ADMIN_USERNAME=
# Use `npm run admin:hash-password` interactively; never put plaintext here.
TOPIC_ADMIN_PASSWORD_HASH=
TOPIC_ADMIN_SESSION_HOURS=12
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ALLOW_PAID_TOPIC_AI_TEST=0
SUIYUE_USAGE_DB_PATH=/var/lib/suiyue-yousheng/usage.sqlite
ARTICLE_AI_DAILY_TOKEN_LIMIT=1000000
TOPIC_AI_DAILY_TOKEN_LIMIT=1100000
ASR_DAILY_SECONDS_LIMIT=7200
# Optional estimates only; provider consoles remain the billing source of truth.
DEEPSEEK_ESTIMATED_INPUT_CNY_PER_MILLION=
DEEPSEEK_ESTIMATED_OUTPUT_CNY_PER_MILLION=
TENCENT_ASR_ESTIMATED_CNY_PER_HOUR=

# Private cloud works: bytes include the complete writing snapshot.
CLOUD_WORK_MAX_BYTES=8388608
CLOUD_ACCOUNT_MAX_BYTES=104857600
CLOUD_ACCOUNT_MAX_WORKS=1000
CLOUD_ACCOUNT_REQUESTS_PER_MINUTE=120

# Reader engagement switches. Disabling new writes preserves existing reading and receipts.
SOCIAL_WRITES_ENABLED=true
SOCIAL_GUEST_OPENING_ENABLED=true
SOCIAL_COMMENTS_ENABLED=true
