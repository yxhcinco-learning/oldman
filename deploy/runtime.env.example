# Install as /etc/suiyue-yousheng/runtime.env with mode 0600 root:root.
# Never commit the populated file or include it in a release archive.
NODE_ENV=production
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3012
ASR_ALLOWED_ORIGIN=https://suiyue.maicong.chat
ASR_CREDENTIAL_SOURCE=project
TENCENT_ASR_APP_ID=1439188935
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_TOKEN=
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_en
ASR_MAX_CONNECTIONS=2
ALLOW_PAID_SPEECH_TEST=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
