# Copy to .env.local. Never commit .env.local or paste keys into chat.
# project: use the ASR fields below. windows-user: reuse existing Windows User
# TENCENTCLOUD_SECRET_ID / TENCENTCLOUD_SECRET_KEY in the gateway process only.
ASR_CREDENTIAL_SOURCE=project
TENCENT_ASR_APP_ID=
# Leave these empty when using windows-user; never copy shared deployment keys here.
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
# Only needed for STS temporary credentials with source=project.
TENCENT_ASR_TOKEN=
# Optional allowlisted engine: 16k_zh (default), 16k_zh_en, or 16k_zh_en_2.0.
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3002
ASR_ALLOWED_ORIGIN=http://localhost:3001
ASR_MAX_CONNECTIONS=2
# Explicit audio-upload tests only. No-audio preflight and normal tests are free of ASR calls.
# Not a spending cap. Interactive recording uses the configured service regardless.
ALLOW_PAID_SPEECH_TEST=0

# 微信小程序无感身份：三项必须同时有效才启用；AppSecret 只放服务端。
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
SUIYUE_AUTH_DB_PATH=/var/lib/suiyue-yousheng/auth.sqlite

# 文章 AI：仅供服务端使用，不要添加 NEXT_PUBLIC_ 或 VITE_ 前缀。
# 填写 Key 后重启网关；只有用户同意并发起优化/追问才调用服务。
# 官方文档：https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
